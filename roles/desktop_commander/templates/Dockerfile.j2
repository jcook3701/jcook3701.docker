ARG BASE_IMAGE=docker.io/library/node:24-bookworm-slim
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG DEVELOPMENT_UID
ARG DEVELOPMENT_GID

USER root

# ---------------------------------------------------------------------------
# Development and System Utilities
# ---------------------------------------------------------------------------
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        bash \
        bash-completion \
        build-essential \
        ca-certificates \
        curl \
        diffutils \
        dnsutils \
        file \
        gh \
        git \
        iproute2 \
        iputils-ping \
        jq \
        less \
        libffi-dev \
        libsqlite3-dev \
        libssl-dev \
        libyaml-dev \
        lsof \
        nano \
        netcat-openbsd \
        openssh-client \
        openssl \
        patch \
        pipx \
        pkg-config \
        procps \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        ripgrep \
        rsync \
        shellcheck \
        sqlite3 \
        tree \
        unzip \
        vim-tiny \
        wget \
        xz-utils \
        yamllint \
        zip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Dedicated Non-root Development Account
# ---------------------------------------------------------------------------
RUN groupadd \
        --gid "${DEVELOPMENT_GID}" \
        chat-gpt \
    && useradd \
        --uid "${DEVELOPMENT_UID}" \
        --gid "${DEVELOPMENT_GID}" \
        --home-dir /home/chat-gpt \
        --no-create-home \
        --shell /bin/bash \
        chat-gpt

# ---------------------------------------------------------------------------
# Runtime Environment
# ---------------------------------------------------------------------------
ENV HOME="/home/chat-gpt" \
    XDG_CONFIG_HOME="/home/chat-gpt/.config" \
    XDG_CACHE_HOME="/home/chat-gpt/.cache" \
    PYTHONUNBUFFERED="1" \
    PYTHONDONTWRITEBYTECODE="1" \
    PIP_DISABLE_PIP_VERSION_CHECK="1" \
    NPM_CONFIG_UPDATE_NOTIFIER="false" \
    GH_NO_UPDATE_NOTIFIER="1" \
    GH_NO_EXTENSION_UPDATE_NOTIFIER="1"

WORKDIR /home/chat-gpt

USER chat-gpt
{% endmacro %}

{{- dockerfile() -}}
