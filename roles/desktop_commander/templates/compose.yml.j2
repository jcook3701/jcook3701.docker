# Auto-generated by Ansible for {{ ansible_fqdn | default(inventory_hostname) }}
# Manual edits will be overwritten.
---
services:
  desktop_commander:
    image: {{ desktop_commander_image | to_json }}
    container_name: {{ desktop_commander_container_name | to_json }}
    pull_policy: {{ desktop_commander_pull_policy | to_json }}
    restart: {{ desktop_commander_restart_policy | to_json }}
    init: true
    user: {{ ((getent_passwd[desktop_commander_system_user][1] | string) ~ ":" ~ (getent_passwd[desktop_commander_system_user][2] | string)) | to_json }}
    working_dir: "/home/chat-gpt"
    command:
      - "npx"
      - "--yes"
      - {{ ("@wonderwhy-er/desktop-commander@" ~ desktop_commander_package_version) | to_json }}
      - "remote"
    environment:
      HOME: "/home/chat-gpt"
      XDG_CONFIG_HOME: "/home/chat-gpt/.config"
      XDG_CACHE_HOME: "/home/chat-gpt/.cache"
      NPM_CONFIG_CACHE: "/home/chat-gpt/.npm"
      NPM_CONFIG_UPDATE_NOTIFIER: "false"
      TMPDIR: "/tmp"
      XDG_RUNTIME_DIR: "/tmp"
    read_only: true
    cap_drop:
      - "ALL"
    security_opt:
      - "no-new-privileges:true"
    pids_limit: {{ desktop_commander_pids_limit | int }}
    mem_limit: {{ desktop_commander_memory_limit | to_json }}
    stop_grace_period: "30s"
    tty: false
    stdin_open: false
    tmpfs:
      - {{ ("/tmp:rw,nosuid,nodev,noexec,mode=1777,size=" ~ desktop_commander_tmpfs_size) | to_json }}
    volumes:
      - type: "bind"
        source: {{ desktop_commander_host_home | to_json }}
        target: "/home/chat-gpt"
        read_only: false
        bind:
          create_host_path: false
          propagation: "rprivate"
    networks:
      - "desktop_commander"
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

networks:
  desktop_commander:
    driver: "bridge"
