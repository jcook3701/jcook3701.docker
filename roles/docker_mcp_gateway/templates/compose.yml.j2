{%- macro compose() -%}
{%- set host_ip = '[' ~ docker_mcp_gateway_bind_ip ~ ']' if ':' in docker_mcp_gateway_bind_ip
  else docker_mcp_gateway_bind_ip -%}
{%- set server_names = docker_mcp_gateway_servers
  + (['freellmapi-relay'] if docker_mcp_gateway_enable_freellmapi_relay | bool else [])
  + (['longmemory-relay'] if docker_mcp_gateway_enable_longmemory_relay | bool else []) -%}
{%- set relay_enabled = docker_mcp_gateway_enable_freellmapi_relay | bool
  or docker_mcp_gateway_enable_longmemory_relay | bool -%}
# SPDX-FileCopyrightText: Copyright © 2026, Jared W. Cook
# SPDX-License-Identifier: AGPL-3.0-or-later
# Auto-generated by Ansible for {{ ansible_fqdn | default(inventory_hostname) }}
# Manual edits will be overwritten.
---
services:
  docker-mcp-gateway:
    image: {{ docker_mcp_gateway_image | to_json }}
    container_name: {{ docker_mcp_gateway_container_name | to_json }}
    pull_policy: {{ docker_mcp_gateway_pull_policy | to_json }}
    restart: {{ docker_mcp_gateway_restart_policy | to_json }}
    command:
      - {{ ("--servers=" ~ (server_names | join(","))) | to_json }}
      - {{ ("--transport=" ~ docker_mcp_gateway_transport) | to_json }}
      - "--port={{ docker_mcp_gateway_internal_port }}"
{% if docker_mcp_gateway_enable_freellmapi_relay | bool %}
      - "--additional-catalog=freellmapi-relay.yaml"
{% endif %}
{% if docker_mcp_gateway_enable_longmemory_relay | bool %}
      - "--additional-catalog=longmemory-relay.yaml"
{% endif %}
{% if relay_enabled %}
      - "--secrets=/run/secrets/freellmapi-relay.env"
{% endif %}
    env_file:
      - {{ docker_mcp_gateway_file.secrets | to_json }}
    environment:
      DOCKER_MCP_IN_CONTAINER: "1"
{% if docker_mcp_gateway_auth_token | length > 0 %}
      MCP_GATEWAY_AUTH_TOKEN: {{ docker_mcp_gateway_auth_token | replace("$", "$$") | to_json }}
{% endif %}
{% if relay_enabled %}
      MCP_GATEWAY_DOCKER_BIND_ALLOWED_PATHS: {{ docker_mcp_gateway_file.relay_script | to_json }}
{% endif %}
    ports:
      - {{ (host_ip ~ ":" ~ docker_mcp_gateway_external_port ~ ":" ~ docker_mcp_gateway_internal_port) | to_json }}
    volumes:
      # Socket access lets the gateway launch its MCP server containers.
      - "/var/run/docker.sock:/var/run/docker.sock"
{% if relay_enabled %}
      - {{ (docker_mcp_gateway_file.relay_script ~ ":" ~ docker_mcp_gateway_file.relay_script ~ ":ro") | to_json }}
{% endif %}
{% if docker_mcp_gateway_enable_freellmapi_relay | bool %}
      - {{ (docker_mcp_gateway_file.relay_catalog ~ ":/root/.docker/mcp/catalogs/freellmapi-relay.yaml:ro") | to_json }}
{% endif %}
{% if docker_mcp_gateway_enable_longmemory_relay | bool %}
      - {{ (docker_mcp_gateway_file.longmemory_relay_catalog ~ ":/root/.docker/mcp/catalogs/longmemory-relay.yaml:ro")
          | to_json }}
{% endif %}
{% if relay_enabled %}
      - {{ (docker_mcp_gateway_file.relay_secrets ~ ":/run/secrets/freellmapi-relay.env:ro") | to_json }}
{% endif %}
    security_opt:
      - "no-new-privileges:true"
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:{{ docker_mcp_gateway_internal_port }}/health"]
      interval: "30s"
      timeout: "5s"
      retries: 5
      start_period: "20s"
{% if docker_mcp_gateway_shared_network | length > 0 %}
    networks:
      - "shared"

networks:
  shared:
    name: {{ docker_mcp_gateway_shared_network | to_json }}
    external: true
{% endif %}
{%- endmacro %}

{{- compose() }}
