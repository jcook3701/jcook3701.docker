{%- macro relay_catalog() -%}
# SPDX-FileCopyrightText: Copyright © 2026, Jared W. Cook
# SPDX-License-Identifier: AGPL-3.0-or-later
# Auto-generated by Ansible for {{ ansible_fqdn | default(inventory_hostname) }}
# Manual edits will be overwritten.
---
name: "freellmapi-relay"
displayName: "FreeLLMAPI relay"
registry:
  freellmapi-relay:
    name: "freellmapi-relay"
    type: "server"
    title: "FreeLLMAPI relay"
    description: "Call selected tools on a trusted FreeLLMAPI instance."
    image: "docker.io/library/python:3.13-alpine"
    user: "65534:65534"
    command: ["python", "-u", "/freellmapi_relay.py"]
    volumes:
      - {{ (docker_mcp_gateway_file.relay_script ~ ":/freellmapi_relay.py:ro") | to_json }}
    env:
      - name: "FREELLMAPI_MCP_URL"
        value: {{ docker_mcp_gateway_freellmapi_mcp_url | to_json }}
    secrets:
      - name: "freellmapi-relay.api_key"
        env: "FREELLMAPI_API_KEY"
    tools:
      - name: "ask_freellmapi"
        description: "Ask FreeLLMAPI to run a model request."
      - name: "list_models"
        description: "List FreeLLMAPI models."
      - name: "healthcheck"
        description: "Check FreeLLMAPI health."
{%- endmacro %}

{{- relay_catalog() }}
