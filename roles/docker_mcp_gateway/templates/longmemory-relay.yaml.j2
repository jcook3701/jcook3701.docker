{%- macro longmemory_relay_catalog() -%}
# SPDX-FileCopyrightText: Copyright © 2026, Jared W. Cook
# SPDX-License-Identifier: AGPL-3.0-or-later
# Auto-generated by Ansible for {{ ansible_fqdn | default(inventory_hostname) }}
# Manual edits will be overwritten.
---
name: "longmemory-relay"
displayName: "LongMemory relay"
registry:
  longmemory-relay:
    name: "longmemory-relay"
    type: "server"
    title: "LongMemory relay"
    description: "Connect to the trusted LongMemory instance on the shared Docker network."
    image: "docker.io/library/python:3.13-alpine"
    user: "65534:65534"
    command: ["python", "-u", "/freellmapi_relay.py", "longmemory"]
    volumes:
      - {{ (docker_mcp_gateway_file.relay_script ~ ":/freellmapi_relay.py:ro") | to_json }}
    env:
      - name: "LONGMEMORY_MCP_URL"
        value: {{ docker_mcp_gateway_longmemory_mcp_url | to_json }}
      - name: "LONGMEMORY_TOOLS"
        value: {{ docker_mcp_gateway_longmemory_tools | join(',') | to_json }}
    secrets:
      - name: "longmemory-relay.api_key"
        env: "LONGMEMORY_API_KEY"
    tools:
{% for tool_name in docker_mcp_gateway_longmemory_tools %}
      - name: {{ tool_name | to_json }}
{% endfor %}
{%- endmacro %}

{{- longmemory_relay_catalog() }}
