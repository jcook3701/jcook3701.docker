{%- macro compose() -%}
{%- set published_ip = ('[' ~ freellmapi_bind_ip ~ ']') if ':' in freellmapi_bind_ip else freellmapi_bind_ip -%}
{%- set published_port = published_ip ~ ':' ~ (freellmapi_external_port | string)
  ~ ':' ~ (freellmapi_internal_port | string) -%}
{%- set agent_network_enabled = (freellmapi_agent_network | length > 0)
  and (freellmapi_agent_network != freellmapi_shared_network) -%}
# SPDX-FileCopyrightText: Copyright © 2026, Jared W. Cook
# SPDX-License-Identifier: AGPL-3.0-or-later
# Auto-generated by Ansible for {{ ansible_fqdn | default(inventory_hostname) }}
# Manual edits will be overwritten.
---
services:
  freellmapi:
    image: {{ freellmapi_image | to_json }}
    container_name: {{ freellmapi_container_name | to_json }}
    pull_policy: {{ freellmapi_pull_policy | to_json }}
    restart: {{ freellmapi_restart_policy | to_json }}
    init: true
    env_file:
      - {{ freellmapi_file.secrets | to_json }}
    environment:
      NODE_ENV: "production"
      PORT: {{ freellmapi_internal_port | string | to_json }}
      FREEAPI_DB_PATH: "/app/server/data/freeapi.db"
      PROXY_RATE_LIMIT_RPM: {{ freellmapi_proxy_rate_limit_rpm | string | to_json }}
      ADMIN_RATE_LIMIT_RPM: {{ freellmapi_admin_rate_limit_rpm | string | to_json }}
      STREAM_KEEPALIVE_MS: {{ freellmapi_stream_keepalive_ms | string | to_json }}
      REQUEST_ANALYTICS_RETENTION_DAYS: {{ freellmapi_request_analytics_retention_days | string | to_json }}
      REQUEST_ANALYTICS_MAX_ROWS: {{ freellmapi_request_analytics_max_rows | string | to_json }}
{% if freellmapi_db_backup_path | length > 0 %}
      FREEAPI_DB_BACKUP_PATH: {{ freellmapi_db_backup_path | to_json }}
{% endif %}
{% if freellmapi_db_backup_url | length > 0 %}
      FREEAPI_DB_BACKUP_URL: {{ freellmapi_db_backup_url | to_json }}
{% endif %}
{% if freellmapi_db_backup_token | length > 0 %}
      FREEAPI_DB_BACKUP_TOKEN: {{ freellmapi_db_backup_token | to_json }}
{% endif %}
{% if freellmapi_db_backup_key | length > 0 %}
      FREEAPI_DB_BACKUP_KEY: {{ freellmapi_db_backup_key | to_json }}
{% endif %}
{% if freellmapi_db_backup_path | length > 0 or freellmapi_db_backup_url | length > 0 %}
      FREEAPI_DB_BACKUP_INTERVAL_MS: {{ freellmapi_db_backup_interval_ms | string | to_json }}
{% endif %}
{% for environment_name, environment_value in freellmapi_extra_environment | dictsort %}
      {{ environment_name | to_json }}: {{ environment_value | to_json }}
{% endfor %}
    ports:
      - {{ published_port | to_json }}
    volumes:
      - type: "bind"
        source: {{ freellmapi_directory.data | to_json }}
        target: "/app/server/data"
        read_only: false
        bind:
          create_host_path: false
          propagation: "rprivate"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    security_opt:
      - "no-new-privileges:true"
    pids_limit: {{ freellmapi_pids_limit | int }}
    mem_limit: {{ freellmapi_memory_limit | to_json }}
    cpus: {{ freellmapi_cpu_limit | to_json }}
    stop_grace_period: {{ freellmapi_stop_grace_period | to_json }}
    healthcheck:
      test:
        - "CMD"
        - "node"
        - "-e"
        - >-
          fetch('http://127.0.0.1:{{ freellmapi_internal_port }}/api/ping')
          .then((res) => { if (!res.ok) process.exit(1); })
          .catch(() => process.exit(1));
      interval: "30s"
      timeout: "5s"
      start_period: "15s"
      retries: 3
    networks:
      - "freellmapi"
{% if freellmapi_shared_network | length > 0 %}
      - "shared"
{% endif %}
{% if agent_network_enabled %}
      - "agent"
{% endif %}
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

networks:
  freellmapi:
    driver: "bridge"
{% if freellmapi_shared_network | length > 0 %}
  shared:
    name: {{ freellmapi_shared_network | to_json }}
    external: true
{% endif %}
{% if agent_network_enabled %}
  agent:
    name: {{ freellmapi_agent_network | to_json }}
    external: true
{% endif %}
{%- endmacro %}
{{- compose() }}
