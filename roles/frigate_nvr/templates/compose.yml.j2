{% macro compose() -%}
services:
  frigate:
    container_name: frigate
    image: "{{ frigate_nvr_image }}:{{ frigate_nvr_version }}"
    privileged: {{ frigate_nvr_privileged | bool | lower }}
    shm_size: "{{ frigate_nvr_shm_size }}"
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    ports:
      - "{{ frigate_nvr_web_port }}:5000"
      - "{{ frigate_nvr_rtsp_port }}:1935"
      - "{{ frigate_nvr_webrtc_port }}:8554"
      - "{{ frigate_nvr_webrtc_udp_port }}:8555/udp"
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - "{{ frigate_nvr_project_src }}/config.yml:/config/config.yml:ro"
      - "{{ frigate_nvr_storage_dir }}:/media/frigate"
    devices:
{% for device in frigate_nvr_devices %}
      - "{{ device }}"
{% endfor %}
    environment:
      FRIGATE_MQTT_HOST: "{{ frigate_nvr_mqtt_host }}"
      FRIGATE_MQTT_USER: "{{ frigate_nvr_mqtt_user }}"
      FRIGATE_MQTT_PASSWORD: "{{ frigate_nvr_mqtt_password }}"
{%- endmacro %}

{{- compose() -}}
