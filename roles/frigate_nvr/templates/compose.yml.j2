{%- macro compose() -%}
{%- set published_ip = ('[' ~ frigate_nvr_bind_ip ~ ']') if ':' in frigate_nvr_bind_ip else frigate_nvr_bind_ip -%}
{%- set unauthenticated_ip = ('[' ~ frigate_nvr_unauthenticated_bind_ip ~ ']')
  if ':' in frigate_nvr_unauthenticated_bind_ip else frigate_nvr_unauthenticated_bind_ip -%}
{%- set image = frigate_nvr_image ~ ':' ~ frigate_nvr_version -%}
# SPDX-FileCopyrightText: Copyright © 2026, Jared W. Cook
# SPDX-License-Identifier: AGPL-3.0-or-later
# Auto-generated by Ansible for {{ ansible_fqdn | default(inventory_hostname) }}
# Manual edits will be overwritten.
---
services:
  frigate:
    image: {{ image | to_json }}
    container_name: {{ frigate_nvr_container_name | to_json }}
    pull_policy: {{ frigate_nvr_pull_policy | to_json }}
    privileged: {{ frigate_nvr_privileged | bool | lower }}
    shm_size: {{ frigate_nvr_shm_size | to_json }}
    restart: {{ frigate_nvr_restart_policy | to_json }}
    stop_grace_period: {{ frigate_nvr_stop_grace_period | to_json }}
    security_opt:
      - "no-new-privileges:true"
    ports:
      - {{ (published_ip ~ ':' ~ (frigate_nvr_web_port | string) ~ ':8971') | to_json }}
      - {{ (published_ip ~ ':' ~ (frigate_nvr_rtsp_port | string) ~ ':8554') | to_json }}
      - {{ (published_ip ~ ':' ~ (frigate_nvr_webrtc_port | string) ~ ':8555/tcp') | to_json }}
      - {{ (published_ip ~ ':' ~ (frigate_nvr_webrtc_udp_port | string) ~ ':8555/udp') | to_json }}
{% if frigate_nvr_publish_unauthenticated_port | bool %}
      - {{ (unauthenticated_ip ~ ':' ~ (frigate_nvr_unauthenticated_port | string) ~ ':5000') | to_json }}
{% endif %}
    volumes:
      - type: "bind"
        source: "/etc/localtime"
        target: "/etc/localtime"
        read_only: true
      - type: "bind"
        source: {{ frigate_nvr_directory.conf | to_json }}
        target: "/config"
        read_only: false
        bind:
          create_host_path: false
          propagation: "rprivate"
{% if frigate_nvr_config_owner == "ansible" %}
      - type: "bind"
        source: {{ frigate_nvr_file.config | to_json }}
        target: "/config/config.yml"
        read_only: true
        bind:
          create_host_path: false
          propagation: "rprivate"
{% endif %}
      - type: "bind"
        source: {{ frigate_nvr_directory.storage | to_json }}
        target: "/media/frigate"
        read_only: false
        bind:
          create_host_path: false
          propagation: "rprivate"
      - type: "tmpfs"
        target: "/tmp/cache"
        tmpfs:
          size: {{ frigate_nvr_tmpfs_size | int }}
{% if frigate_nvr_devices | length > 0 %}
    devices:
{% for device in frigate_nvr_devices %}
      - {{ device | to_json }}
{% endfor %}
{% endif %}
    environment:
      TZ: {{ frigate_nvr_timezone | to_json }}
{% if frigate_nvr_mqtt_enabled | bool %}
      FRIGATE_MQTT_HOST: {{ frigate_nvr_mqtt_host | to_json }}
{% if frigate_nvr_mqtt_user | length > 0 %}
      FRIGATE_MQTT_USER: {{ frigate_nvr_mqtt_user | to_json }}
      FRIGATE_MQTT_PASSWORD: {{ frigate_nvr_mqtt_password | to_json }}
{% endif %}
{% endif %}
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
{%- endmacro %}
{{- compose() }}
