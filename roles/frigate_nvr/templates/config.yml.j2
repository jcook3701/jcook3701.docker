{% macro config() -%}
---
# Frigate Global System Configuration
# -----------------------------------------------------------------------------
mqtt:
  host: "{{ frigate_nvr_mqtt_host }}"
  {% if frigate_nvr_mqtt_user | length > 0 %}
  user: "{{ frigate_nvr_mqtt_user }}"
  password: "{{ frigate_nvr_mqtt_password }}"
  {% endif %}

database:
  path: /media/frigate/frigate.db

# Global Video and Stream Interception Defaults
# -----------------------------------------------------------------------------
detectors:
  coral:
    type: edgetpu
    device: usb

record:
  enabled: true
  retain:
    days: 7
    mode: all

snapshots:
  enabled: true
  retain:
    default: 14

# Camera Matrix Mapping Pipeline
# -----------------------------------------------------------------------------
cameras:
{% for camera in frigate_nvr_cameras | default([]) %}
  {{ camera.name }}:
    enabled: {{ camera.enabled | default(true) | bool | lower }}
    ffmpeg:
      inputs:
{% for input in camera.inputs %}
        - path: "{{ input.path }}"
          roles:
{% for role in input.roles %}
            - {{ role }}
{% endfor %}
{% endfor %}
    detect:
      enabled: {{ camera.detect_enabled | default(true) | bool | lower }}
      width: {{ camera.width | default(1920) }}
      height: {{ camera.height | default(1080) }}
      fps: {{ camera.fps | default(5) }}
{% if camera.zones is defined %}
    zones:
{% for zone_name, zone_details in camera.zones.items() %}
      {{ zone_name }}:
        coordinates: "{{ zone_details.coordinates }}"
{% endfor %}
{% endif %}
{% endfor %}
{%- endmacro %}

{{- config() -}}
