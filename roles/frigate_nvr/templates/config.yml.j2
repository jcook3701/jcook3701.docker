{%- macro config() -%}
# SPDX-FileCopyrightText: Copyright © 2026, Jared W. Cook
# SPDX-License-Identifier: AGPL-3.0-or-later
# Auto-generated by Ansible for {{ ansible_fqdn | default(inventory_hostname) }}
{% if frigate_nvr_config_owner == "ansible" %}
# Manual edits will be overwritten.
{% else %}
# Seeded once by Ansible; Frigate owns subsequent changes.
{% endif %}
---
mqtt:
{% if frigate_nvr_mqtt_enabled | bool %}
  host: "{FRIGATE_MQTT_HOST}"
{% if frigate_nvr_mqtt_user | length > 0 %}
  user: "{FRIGATE_MQTT_USER}"
  password: "{FRIGATE_MQTT_PASSWORD}"
{% endif %}
{% else %}
  enabled: false
{% endif %}

database:
  path: "/media/frigate/frigate.db"

{% if frigate_nvr_detectors | length > 0 %}
detectors:
{% for detector_name, detector_config in frigate_nvr_detectors | dictsort %}
  {{ detector_name | to_json }}: {{ detector_config | to_json }}
{% endfor %}

{% endif %}
record:
{{ frigate_nvr_record | to_nice_yaml(indent=2) | indent(2, true) }}

snapshots:
{{ frigate_nvr_snapshots | to_nice_yaml(indent=2) | indent(2, true) }}

{% if frigate_nvr_extra_config | length > 0 %}
{% for config_name, config_value in frigate_nvr_extra_config | dictsort %}
{{ config_name | to_json }}: {{ config_value | to_json }}
{% endfor %}
{% endif %}
{% if frigate_nvr_cameras | length == 0 %}
cameras: {}
{% else %}
cameras:
{% for camera in frigate_nvr_cameras %}
  {{ camera.name | to_json }}:
    enabled: {{ camera.enabled | default(true) | bool | lower }}
    ffmpeg:
      inputs:
{% for input in camera.inputs | default([]) %}
        - path: {{ input.path | to_json }}
          roles:
{% for role in input.roles | default([]) %}
            - {{ role | to_json }}
{% endfor %}
{% endfor %}
    detect:
      enabled: {{ camera.detect_enabled | default(true) | bool | lower }}
      width: {{ camera.width | default(1920) | int }}
      height: {{ camera.height | default(1080) | int }}
      fps: {{ camera.fps | default(5) | int }}
{% if camera.zones is defined and camera.zones | length > 0 %}
    zones:
{% for zone_name, zone_config in camera.zones | dictsort %}
      {{ zone_name | to_json }}: {{ zone_config | to_json }}
{% endfor %}
{% endif %}
{% if camera.extra_config is defined and camera.extra_config | length > 0 %}
{% for config_name, config_value in camera.extra_config | dictsort %}
    {{ config_name | to_json }}: {{ config_value | to_json }}
{% endfor %}
{% endif %}
{% endfor %}
{%- endif %}
{%- endmacro %}
{{- config() -}}
