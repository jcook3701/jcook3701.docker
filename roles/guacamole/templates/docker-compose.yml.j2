{% macro docker_compose() %}
version: '2.0'

# networks
# create a network 'guacnetwork_compose' in mode 'bridged'
networks:
  guacnetwork:
    driver: bridge

# services
services:
  # guacd
  guacd:
    container_name: guacd
    image: guacamole/guacd
    # ports:
    # - 4822:4822
    networks:
      guacnetwork:
    restart: always
    volumes:
    - ./drive:/drive:rw
    - ./record:/record:rw

  # postgres
  postgres:
    container_name: postgres
    environment:
      PGDATA: /var/lib/postgresql/data/guacamole
      POSTGRES_DB: guacamole_db
      POSTGRES_PASSWORD: guacamole_password
      POSTGRES_USER: guacamole_user
    image: postgres:12
    networks:
      guacnetwork:
    restart: always
    volumes:
    - ./init:/docker-entrypoint-initdb.d:ro
    - ./data:/var/lib/postgresql/data:rw
#    ports:
#      - 5431:5432

  # guacamole
  guacamole:
    container_name: guacamole
    depends_on:
    - guacd
    - postgres
    environment:
      GUACD_HOSTNAME: guacd
      POSTGRES_HOSTNAME: postgres
      POSTGRES_PORT: 5432
      POSTGRES_DATABASE: guacamole_db
      POSTGRES_PASSWORD: guacamole_password
      POSTGRES_USER: guacamole_user
      GUACAMOLE_HOME: /etc/guacamole
      LDAP_HOSTNAME: {{ guacamole_ldap_hostname }}.{{ guacamole_second_level_domain }}.{{ guacamole_top_level_domain }}
      LDAP_ENCRYPTION_METHOD: none
      LDAP_USER_BASE_DN: ou=People,ou=Users,dc={{ guacamole_second_level_domain }},dc={{ guacamole_top_level_domain }}
      LDAP_CONFIG_BASE_DN: ou=Computers,ou=Users,dc={{ guacamole_second_level_domain }},dc={{ guacamole_top_level_domain }}
      LDAP_GROUP_BASE_DN: ou=Group,dc={{ guacamole_second_level_domain }},dc={{ guacamole_top_level_domain }}
      LDAP_USERNAME_ATTRIBUTE: uid
      LDAP_GROUP_NAME_ATTRIBUTE: cn
    #build:
    #  context: ./Dockerfiles/.
    #  dockerfile: dockerfile_guacamole_ldap
    image: {{ guacamole_docker_image }}
    volumes:
    - ./guacamole_home/guacamole.properties:/etc/guacamole/guacamole.properties
    links:
    - guacd
    networks:
      guacnetwork:
    ports:
    - 8080/tcp
    restart: always

  #nginx proxy
  nginx:
    container_name: nginx
    image: nginx
    restart: always
    volumes:
    - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
    - ./nginx/mysite.template:/etc/nginx/conf.d/mysite.template
    - /etc/pki/tls/certs/nginx:/etc/nginx/ssl
    ports:
    - 443:443
    links:
    - guacamole
    networks:
      guacnetwork:

    command: >-
      /bin/bash -c "apt-get -y update && apt-get -y install openssl &&
      openssl req -days 3650 -nodes -newkey rsa:2048 -new -x509
      -keyout /etc/nginx/ssl/self-ssl.key
      -out /etc/nginx/ssl/self.cert
      -subj '/C={{ guacamole_ssl.country }}/ST={{ guacamole_ssl.state }}/L={{ guacamole_ssl.city }}/O=ldap-admin/OU=People/CN={{ guacamole_second_level_domain }}.{{ guacamole_top_level_domain }}' &&
      cp -f -s /etc/nginx/conf.d/mysite.template /etc/nginx/conf.d/default.conf &&
      nginx -g 'daemon off;'"
{% endmacro %}

{{- docker_compose() -}}
