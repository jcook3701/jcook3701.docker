{% macro guacamole_properties() %}
#
# GUACD Config #
#

# GUACD_HOSTNAME
# guacd-hostname: guacd

# GUACD_PORT
# guacd-port: 4822

# GUACD_SSL:
# guacd-ssl: false

#
# LDAP Config
#

## LDAP_HOSTNAME: hostname.example.com
# ldap-hostname: 192.168.1.2

## LDAP_ENCRYPTION_METHOD:
# ldap-encryption-method: ssl

## LDAP_USER_BASE_DN: ou=people,dc=field,dc=example,dc=com
# ldap-user-base-dn: ou=Users,ou=People,dc={{ guacamole_second_level_domain }},dc={{ guacamole_top_level_domain }}

## LDAP_CONFIG_BASE_DN: ou=computer,dc=field,dc=example,dc=com
# ldap-config-base-dn: ou=Users,ou=Computers,dc={{ guacamole_second_level_domain }},dc={{ guacamole_top_level_domain }}

## LDAP_GROUP_BASE_DN: ou=group,dc=field,dc=example,dc=com
# ldap-group-base-dn: ou=Group,dc={{ guacamole_second_level_domain }},dc={{ guacamole_top_level_domain }}

## LDAP_USERNAME_ATTRIBUTE:
# ldap-username-attribute: uid

## LDAP_GROUP_NAME_ATTRIBUTE:
# ldap-group-name-attribute: cn
{% endmacro %}

{{- guacamole_properties() -}}
