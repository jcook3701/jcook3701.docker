{%- macro compose() -%}
{%- set published_ip = ('[' ~ headroom_bind_ip ~ ']') if ':' in headroom_bind_ip else headroom_bind_ip -%}
{%- set published_port = published_ip ~ ':' ~ (headroom_external_port | string)
  ~ ':' ~ (headroom_internal_port | string) -%}
# SPDX-FileCopyrightText: Copyright © 2026, Jared W. Cook
# SPDX-License-Identifier: AGPL-3.0-or-later
# Auto-generated by Ansible for {{ ansible_fqdn | default(inventory_hostname) }}
# Manual edits will be overwritten.
---
services:
  headroom:
    image: {{ headroom_image | to_json }}
    container_name: {{ headroom_container_name | to_json }}
    pull_policy: {{ headroom_pull_policy | to_json }}
    restart: {{ headroom_restart_policy | to_json }}
    init: true
    working_dir: "/home/nonroot"
    command:
      - "--host"
      - "0.0.0.0"
      - "--port"
      - {{ headroom_internal_port | string | to_json }}
      - "--mode"
      - {{ headroom_proxy_mode | to_json }}
    environment:
      HOME: "/home/nonroot"
      HF_HOME: "/home/nonroot/.headroom/cache/huggingface"
      XDG_CACHE_HOME: "/home/nonroot/.headroom/cache"
      TMPDIR: "/tmp"
      HEADROOM_HOST: "0.0.0.0"
      HEADROOM_PORT: {{ headroom_internal_port | string | to_json }}
      HEADROOM_MODE: {{ headroom_proxy_mode | to_json }}
      HEADROOM_WORKSPACE_DIR: "/home/nonroot/.headroom"
      HEADROOM_CONFIG_DIR: "/home/nonroot/.headroom/config"
      HEADROOM_BEACON: {{ headroom_beacon | to_json }}
{% if headroom_proxy_token | length > 0 %}
      HEADROOM_PROXY_TOKEN: {{ headroom_proxy_token | to_json }}
{% else %}
      HEADROOM_ALLOW_UNAUTHENTICATED_BIND: "1"
{% endif %}
{% for environment_name, environment_value in headroom_extra_environment | dictsort %}
      {{ environment_name | to_json }}: {{ environment_value | to_json }}
{% endfor %}
    ports:
      - {{ published_port | to_json }}
    volumes:
      - type: "bind"
        source: {{ headroom_directory.data | to_json }}
        target: "/home/nonroot/.headroom"
        read_only: false
        bind:
          create_host_path: false
          propagation: "rprivate"
    read_only: true
    cap_drop:
      - "ALL"
    security_opt:
      - "no-new-privileges:true"
    pids_limit: {{ headroom_pids_limit | int }}
    mem_limit: {{ headroom_memory_limit | to_json }}
    cpus: {{ headroom_cpu_limit | to_json }}
    stop_grace_period: "30s"
    tmpfs:
      - {{ ("/tmp:rw,nosuid,nodev,noexec,mode=1777,size=" ~ headroom_tmpfs_size) | to_json }}
    networks:
      - "headroom"
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

networks:
  headroom:
    driver: "bridge"
{%- endmacro %}
{{- compose() }}
