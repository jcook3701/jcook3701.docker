{% macro docker_compose() %}
# SPDX-FileCopyrightText: Copyright © 2026, Jared W. Cook
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Auto-generated by Ansible for {{ ansible_fqdn | default(inventory_hostname) }}
# Manual edits will be overwritten.
---
services:
  # -------------------------------------------------------------------------
  # Headscale Coordination Server
  # -------------------------------------------------------------------------
  headscale:
    image: {{ headscale_image | default('docker.io/headscale/headscale:0.29.7') | to_json }}
    container_name: {{ headscale_container_name | default('headscale') | to_json }}
    pull_policy: {{ headscale_pull_policy | default('always') | to_json }}
    restart: {{ headscale_restart_policy | default('unless-stopped') | to_json }}
{% if headscale_manage_headplane | default(false) | bool and
      headscale_headplane_docker_enabled | default(false) | bool %}
    labels:
      me.tale.headplane.target: "headscale"
{% endif %}
    read_only: true
    tmpfs:
      - "/var/run/headscale"
    command:
      - "serve"
    ports:
      - {{ ((headscale_host_bind_ip | default('127.0.0.1')) ~ ':' ~
          (headscale_external_port | default(8080) | string) ~ ':' ~
          (headscale_internal_port | default(8080) | string) ~ '/tcp') | to_json }}
{% if headscale_derp_embedded_enabled | default(false) | bool %}
      # Embedded DERP requires publicly reachable UDP/3478 for STUN.
      - "3478:3478/udp"
{% endif %}
{% if headscale_metrics_enabled | default(false) | bool %}
      # Metrics are intentionally not exposed on the LAN.
      - {{ ('127.0.0.1:' ~ (headscale_metrics_external_port | default(9090) | string) ~ ':' ~
          (headscale_metrics_internal_port | default(9090) | string) ~ '/tcp') | to_json }}
{% endif %}
    volumes:
      - {{ ((headscale_directory.config | default('/opt/headscale/config')) ~ ':/etc/headscale:ro') | to_json }}
      - {{ ((headscale_directory.lib | default('/opt/headscale/lib')) ~ ':/var/lib/headscale') | to_json }}
{% if headscale_extra_environment | default({}) | length > 0 %}
    environment:
{% for env_name, env_value in (headscale_extra_environment | default({})).items() %}
      {{ env_name }}: {{ env_value | string | to_json }}
{% endfor %}
{% endif %}
    healthcheck:
      test: ["CMD", "headscale", "health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    networks:
      - headscale

{% if headscale_manage_headplane | default(false) | bool and
      headscale_headplane_api_key_status.stat.exists | default(false) | bool %}
  # -------------------------------------------------------------------------
  # Optional Headplane Web Dashboard
  # -------------------------------------------------------------------------
  headplane:
    image: {{ headscale_headplane_image | default('ghcr.io/tale/headplane:0.8.1') | to_json }}
    container_name: {{ headscale_headplane_container_name | default('headplane') | to_json }}
    labels:
      com.jcook3701.docker.role: "headscale"
    pull_policy: {{ headscale_pull_policy | default('always') | to_json }}
    restart: {{ headscale_restart_policy | default('unless-stopped') | to_json }}
    user: "0:0"
    depends_on:
      headscale:
        condition: service_healthy
    ports:
      - {{ ((headscale_headplane_host_bind_ip | default('0.0.0.0')) ~ ':' ~
          (headscale_headplane_external_port | default(3001) | string) ~ ':' ~
          (headscale_headplane_internal_port | default(3000) | string) ~ '/tcp') | to_json }}
    volumes:
      - {{ ((headscale_directory.headplane_config | default('/opt/headscale/headplane/config')) ~
          ':/etc/headplane:ro') | to_json }}
      - {{ ((headscale_directory.headplane_data | default('/opt/headscale/headplane/data')) ~
          ':/var/lib/headplane') | to_json }}
{% if headscale_headplane_docker_enabled | default(false) | bool %}
      - {{ ((headscale_file.config | default('/opt/headscale/config/config.yaml')) ~
          ':/etc/headscale/config.yaml') | to_json }}
      - "/var/run/docker.sock:/var/run/docker.sock:ro"
{% else %}
      - {{ ((headscale_file.config | default('/opt/headscale/config/config.yaml')) ~
          ':/etc/headscale/config.yaml:ro') | to_json }}
{% endif %}
    networks:
      - headscale
{% endif %}

# ---------------------------------------------------------------------------
# Container Networking
# ---------------------------------------------------------------------------
networks:
  headscale:
    driver: bridge

{% endmacro %}

{{- docker_compose() -}}
