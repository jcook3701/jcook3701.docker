{% macro config() %}
# SPDX-FileCopyrightText: Copyright © 2026, Jared Cook
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Auto-generated by Ansible for {{ ansible_fqdn | default(inventory_hostname) }}
# Manual edits will be overwritten.
# Based on the configuration schema for Headscale 0.29.7.
---
# ---------------------------------------------------------------------------
# Coordination Server
# ---------------------------------------------------------------------------
server_url: {{ headscale_server_url | default('https://headscale.example.com') | to_json }}
listen_addr: {{ ('0.0.0.0:' ~ (headscale_internal_port | default(8080) | string)) | to_json }}
{% if headscale_metrics_enabled | default(false) | bool %}
metrics_listen_addr: {{ ('0.0.0.0:' ~ (headscale_metrics_internal_port | default(9090) | string)) | to_json }}
{% else %}
metrics_listen_addr: ""
{% endif %}
grpc_listen_addr: "127.0.0.1:50443"
grpc_allow_insecure: false
trusted_proxies: {{ headscale_trusted_proxies | default([]) | to_json }}

# ---------------------------------------------------------------------------
# Noise Protocol and Tailnet Address Allocation
# ---------------------------------------------------------------------------
noise:
  private_key_path: "/var/lib/headscale/noise_private.key"

prefixes:
  v4: {{ headscale_prefix_v4 | default('100.64.0.0/10') | to_json }}
  v6: {{ headscale_prefix_v6 | default('fd7a:115c:a1e0::/48') | to_json }}
  allocation: {{ headscale_prefix_allocation | default('sequential') | to_json }}

# ---------------------------------------------------------------------------
# DERP Relay Discovery
# ---------------------------------------------------------------------------
derp:
  server:
    enabled: {{ headscale_derp_embedded_enabled | default(false) | bool | lower }}
    region_id: 999
    region_code: "headscale"
    region_name: "Headscale Embedded DERP"
    verify_clients: true
    stun_listen_addr: "0.0.0.0:3478"
    private_key_path: "/var/lib/headscale/derp_server_private.key"
    automatically_add_embedded_derp_region: true
  urls: {{ headscale_derp_urls | default(['https://controlplane.tailscale.com/derpmap/default']) | to_json }}
  paths: []
  auto_update_enabled: {{ headscale_derp_auto_update_enabled | default(true) | bool | lower }}
  update_frequency: {{ headscale_derp_update_frequency | default('3h') | to_json }}

# ---------------------------------------------------------------------------
# Persistent Database
# ---------------------------------------------------------------------------
database:
  type: sqlite
  sqlite:
    path: "/var/lib/headscale/db.sqlite"
    write_ahead_log: true
    wal_autocheckpoint: 1000

# ---------------------------------------------------------------------------
# Logging and Access Policy
# ---------------------------------------------------------------------------
log:
  level: {{ headscale_log_level | default('info') | to_json }}
  format: {{ headscale_log_format | default('text') | to_json }}

policy:
  mode: {{ headscale_policy_mode | default('file') | to_json }}
  path: {{ headscale_policy_path | default('') | to_json }}

# ---------------------------------------------------------------------------
# MagicDNS and DNS Resolvers
# ---------------------------------------------------------------------------
dns:
  magic_dns: {{ headscale_dns_magic_dns | default(true) | bool | lower }}
  base_domain: {{ headscale_dns_base_domain | default('tailnet.example.com') | to_json }}
  override_local_dns: {{ headscale_dns_override_local_dns | default(true) | bool | lower }}
  nameservers:
    global: {{ headscale_dns_nameservers_global | default(['1.1.1.1', '1.0.0.1']) | to_json }}
    split: {{ headscale_dns_nameservers_split | default({}) | to_json }}
  search_domains: {{ headscale_dns_search_domains | default([]) | to_json }}
  extra_records: {{ headscale_dns_extra_records | default([]) | to_json }}

# ---------------------------------------------------------------------------
# Internal Management Socket and Client Capabilities
# ---------------------------------------------------------------------------
unix_socket: "/var/run/headscale/headscale.sock"
unix_socket_permission: "0770"

logtail:
  enabled: {{ headscale_logtail_enabled | default(false) | bool | lower }}

taildrop:
  enabled: {{ headscale_taildrop_enabled | default(true) | bool | lower }}

{% endmacro %}

{{- config() -}}
