#
# Auto-generated by Ansible for {{ ansible_fqdn | default(inventory_hostname) }}
# Manual edits will be overwritten.
---
# ---------------------------------------------------------------------------
# Headplane Web Server Configuration
# ---------------------------------------------------------------------------
server:
  host: "0.0.0.0"
  port: {{ headscale_headplane_internal_port | default(3000) | int }}
  base_path: "/admin"
  base_url: {{ ((headscale_headplane_base_url | default(''))
      if (headscale_headplane_base_url | default('') | length > 0)
      else ('http://' ~ (ansible_fqdn | default(inventory_hostname)) ~ ':' ~
      (headscale_headplane_external_port | default(3001) | string))) | to_json }}
  cookie_secret_path: "/etc/headplane/cookie_secret"
  cookie_secure: {{ headscale_headplane_cookie_secure | default(false) | bool | lower }}
  data_path: "/var/lib/headplane"

# ---------------------------------------------------------------------------
# Headscale API Integration
# ---------------------------------------------------------------------------
headscale:
  url: {{ ('http://headscale:' ~ (headscale_internal_port | default(8080) | string)) | to_json }}
  public_url: {{ headscale_server_url | default('https://headscale.example.com') | to_json }}
  config_path: "/etc/headscale/config.yaml"
  api_key_path: "/etc/headplane/api_key"

# ---------------------------------------------------------------------------
# Optional Integration Features
# ---------------------------------------------------------------------------
integration:
  agent:
    enabled: false
  docker:
    enabled: false
  kubernetes:
    enabled: false
    pod_name: {{ headscale_headplane_kubernetes_pod_name | default('headscale') | to_json }}
  proc:
    enabled: false

{%- endmacro -%}

{{- config() -}}
