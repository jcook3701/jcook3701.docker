{%- macro compose() -%}
{%- set published_ip = ('[' ~ longmemory_bind_ip ~ ']') if ':' in longmemory_bind_ip else longmemory_bind_ip -%}
# SPDX-FileCopyrightText: Copyright © 2026, Jared W. Cook
# SPDX-License-Identifier: AGPL-3.0-or-later
# Auto-generated by Ansible for {{ ansible_fqdn | default(inventory_hostname) }}
# Manual edits will be overwritten.
---
services:
  longmemory:
    image: {{ longmemory_image | to_json }}
    container_name: {{ longmemory_container_name | to_json }}
{% if longmemory_build_from_source | bool %}
    build:
      context: {{ longmemory_directory.source | to_json }}
      dockerfile: "Dockerfile"
    pull_policy: "build"
{% else %}
    pull_policy: {{ ("always" if longmemory_pull_images | bool else longmemory_pull_policy) | to_json }}
{% endif %}
    restart: {{ longmemory_restart_policy | to_json }}
    init: true
    command:
      - "./node_modules/.bin/longmemory"
      - "serve"
{% if longmemory_enable_mcp %}
      - "--mcp-http"
{% endif %}
    env_file:
      - {{ longmemory_file.secrets | to_json }}
    environment:
      LONGMEMORY_HOST: "0.0.0.0"
      LONGMEMORY_PORT: {{ longmemory_internal_port | string | replace("$", "$$") | to_json }}
      LONGMEMORY_DB_PATH: "/data/longmemory.db"
      LONGMEMORY_MCP_HTTP: {{ longmemory_enable_mcp | string | lower | replace("$", "$$") | to_json }}
      LONGMEMORY_ALLOWED_ORIGINS: {{ longmemory_allowed_origins | string | replace("$", "$$") | to_json }}
      LONGMEMORY_RATE_LIMIT_ENABLED: {{ longmemory_rate_limit_enabled | string | lower | replace("$", "$$") | to_json }}
      LONGMEMORY_RATE_LIMIT_MAX_REQUESTS: {{ longmemory_rate_limit_max_requests | string | replace("$", "$$") | to_json }}
      LONGMEMORY_EMBEDDING_PROVIDER: {{ longmemory_embedding_provider | string | replace("$", "$$") | to_json }}
      LONGMEMORY_EMBEDDING_TIER: {{ longmemory_embedding_tier | string | replace("$", "$$") | to_json }}
      LONGMEMORY_EMBEDDING_DIMENSION: {{ longmemory_embedding_dimension | string | replace("$", "$$") | to_json }}
      LONGMEMORY_OLLAMA_URL: {{ longmemory_ollama_url | string | replace("$", "$$") | to_json }}
      LONGMEMORY_OLLAMA_EMBEDDING_MODEL: {{ longmemory_ollama_embedding_model | string | replace("$", "$$") | to_json }}
{% for environment_name, environment_value in longmemory_extra_environment | dictsort %}
      {{ environment_name | to_json }}: {{ environment_value | string | replace("$", "$$") | to_json }}
{% endfor %}
    ports:
      - {{ (published_ip ~ ':' ~ longmemory_external_port ~ ':' ~ longmemory_internal_port) | to_json }}
    volumes:
      - "longmemory_data:/data"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    security_opt:
      - "no-new-privileges:true"
    pids_limit: {{ longmemory_pids_limit | int }}
    mem_limit: {{ longmemory_memory_limit | to_json }}
    cpus: {{ longmemory_cpu_limit | to_json }}
    stop_grace_period: {{ longmemory_stop_grace_period | to_json }}
    healthcheck:
      test:
        - "CMD"
        - "node"
        - "-e"
        - >-
          fetch('http://127.0.0.1:{{ longmemory_internal_port }}/health')
          .then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))
      interval: "30s"
      timeout: "5s"
      start_period: "20s"
      retries: 3
    networks:
      - "longmemory"
{% if longmemory_shared_network | length > 0 %}
      - "shared"
{% endif %}
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
{% if longmemory_enable_dashboard %}
  dashboard:
    image: {{ longmemory_dashboard_image | to_json }}
    build:
      context: {{ (longmemory_directory.source ~ '/dashboard') | to_json }}
      dockerfile: "Dockerfile"
    pull_policy: "build"
    restart: {{ longmemory_restart_policy | to_json }}
    init: true
    env_file:
      - {{ longmemory_file.secrets | to_json }}
    environment:
      LONGMEMORY_API_URL: {{ ('http://longmemory:' ~ longmemory_internal_port) | to_json }}
    ports:
      - {{ (published_ip ~ ':' ~ longmemory_dashboard_external_port ~ ':3000') | to_json }}
    depends_on:
      longmemory:
        condition: "service_healthy"
    security_opt:
      - "no-new-privileges:true"
    networks:
      - "longmemory"
{% endif %}

networks:
  longmemory:
    driver: "bridge"
{% if longmemory_shared_network | length > 0 %}
  shared:
    name: {{ longmemory_shared_network | to_json }}
    external: true
{% endif %}

volumes:
  longmemory_data:
    external: true
    name: "longmemory_data"
{%- endmacro %}

{{- compose() -}}
