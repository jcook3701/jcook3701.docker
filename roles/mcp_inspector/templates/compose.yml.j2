{%- macro compose() -%}
{%- set host_ip = '[' ~ mcp_inspector_bind_ip ~ ']' if ':' in mcp_inspector_bind_ip else mcp_inspector_bind_ip -%}
# SPDX-FileCopyrightText: Copyright © 2026, Jared W. Cook
# SPDX-License-Identifier: AGPL-3.0-or-later
# Auto-generated by Ansible for {{ ansible_fqdn | default(inventory_hostname) }}
# Manual edits will be overwritten.
---
services:
  mcp-inspector:
    image: {{ mcp_inspector_image | to_json }}
    container_name: {{ mcp_inspector_container_name | to_json }}
    pull_policy: {{ mcp_inspector_pull_policy | to_json }}
    restart: {{ mcp_inspector_restart_policy | to_json }}
    ports:
      - {{ (host_ip ~ ":" ~ mcp_inspector_external_port ~ ":" ~ mcp_inspector_internal_port) | to_json }}
      - {{ (host_ip ~ ":" ~ mcp_inspector_sandbox_port ~ ":" ~ mcp_inspector_sandbox_port) | to_json }}
      - {{ (host_ip ~ ":" ~ mcp_inspector_app_origin_port ~ ":" ~ mcp_inspector_app_origin_port) | to_json }}
    volumes:
      - {{ (mcp_inspector_directory.data ~ ":/home/node/.mcp-inspector") | to_json }}
      - {{ (mcp_inspector_file.secrets ~ ":/run/secrets/mcp_inspector_secret_key:ro") | to_json }}
    environment:
      HOST: "0.0.0.0"
      CLIENT_PORT: {{ mcp_inspector_internal_port | string | replace("$", "$$") | to_json }}
      MCP_SANDBOX_PORT: {{ mcp_inspector_sandbox_port | string | replace("$", "$$") | to_json }}
      MCP_APP_ORIGIN_PORT: {{ mcp_inspector_app_origin_port | string | replace("$", "$$") | to_json }}
      MCP_AUTO_OPEN_ENABLED: "false"
      DANGEROUSLY_BIND_ALL_INTERFACES: "true"
      MCP_INSPECTOR_SECRET_KEY_FILE: "/run/secrets/mcp_inspector_secret_key"
{% if mcp_inspector_allowed_origins | length > 0 %}
      ALLOWED_ORIGINS: {{ (mcp_inspector_allowed_origins | join(',')) | string | replace("$", "$$") | to_json }}
{% endif %}
    security_opt:
      - "no-new-privileges:true"
{% if mcp_inspector_shared_network | length > 0 %}
    networks:
      - "default"
      - "shared"
{% endif %}
{% if mcp_inspector_shared_network | length > 0 %}

networks:
  shared:
    name: {{ mcp_inspector_shared_network | to_json }}
    external: true
{% endif %}
{%- endmacro %}

{{- compose() }}
