{% macro docker_compose() %}
version: '3.8'

services:
  mirth-db:
    image: postgres:15-alpine
    container_name: mirth_postgres
    restart: always
    environment:
      POSTGRES_USER: "{{ mirth_db_user }}"
      POSTGRES_PASSWORD: "{{ mirth_db_password }}"
      POSTGRES_DB: "{{ mirth_db_name }}"
    volumes:
      - "{{ mirth_project_dir }}/db_data:/var/lib/postgresql/data"
    networks:
      - mirth-network

  mirth-app:
    image: nextgenhealthcare/mirth-connect:latest
    container_name: mirth_connect
    restart: always
    depends_on:
      - mirth-db
    ports:
      - "8443:8443"  # Mirth Administrator GUI (HTTPS)
      - "{{ edan_mllp_port }}:{{ edan_mllp_port }}"  # Dedicated port for Edan iM3 HL7 stream
    environment:
      - DATABASE=postgres
      - DATABASE_URL=jdbc:postgresql://mirth-db:5432/{{ mirth_db_name }}
      - DATABASE_USERNAME={{ mirth_db_user }}
      - DATABASE_PASSWORD={{ mirth_db_password }}
      - VMOPTIONS=-Xmx1024m
    volumes:
      - "{{ mirth_project_dir }}/app_data:/opt/mirth-connect/appdata"
    networks:
      - mirth-network

networks:
  mirth-network:
    driver: bridge
{% endmacro %}

{{- docker_compose() -}}
