{%- macro compose() -%}
{%- set host_ip = '[' ~ n8n_bind_ip ~ ']' if ':' in n8n_bind_ip else n8n_bind_ip -%}
{%- set public_host = n8n_host if n8n_host | length > 0 else ansible_fqdn | default(inventory_hostname) -%}
# SPDX-FileCopyrightText: Copyright © 2026, Jared W. Cook
# SPDX-License-Identifier: AGPL-3.0-or-later
# Auto-generated by Ansible for {{ ansible_fqdn | default(inventory_hostname) }}
# Manual edits will be overwritten.
---
services:
  n8n:
    image: {{ n8n_image | to_json }}
    container_name: {{ n8n_container_name | to_json }}
    pull_policy: {{ n8n_pull_policy | to_json }}
    restart: {{ n8n_restart_policy | to_json }}
    ports:
      - {{ (host_ip ~ ":" ~ n8n_external_port ~ ":" ~ n8n_internal_port) | to_json }}
    volumes:
      - {{ (n8n_directory.data ~ ":/home/node/.n8n") | to_json }}
    environment:
      N8N_HOST: {{ public_host | replace("$", "$$") | to_json }}
      N8N_PORT: {{ n8n_internal_port | string | replace("$", "$$") | to_json }}
      N8N_LISTEN_ADDRESS: "0.0.0.0"
      N8N_PROTOCOL: {{ n8n_protocol | string | replace("$", "$$") | to_json }}
      N8N_SECURE_COOKIE: {{ (n8n_secure_cookie | bool | lower) | string | replace("$", "$$") | to_json }}
      N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS: "true"
      N8N_PROXY_HOPS: {{ n8n_proxy_hops | string | replace("$", "$$") | to_json }}
      GENERIC_TIMEZONE: {{ n8n_timezone | string | replace("$", "$$") | to_json }}
      TZ: {{ n8n_timezone | string | replace("$", "$$") | to_json }}
{% if n8n_encryption_key | length > 0 %}
      N8N_ENCRYPTION_KEY: {{ n8n_encryption_key | string | replace("$", "$$") | to_json }}
{% endif %}
{% if n8n_editor_base_url | length > 0 %}
      N8N_EDITOR_BASE_URL: {{ n8n_editor_base_url | string | replace("$", "$$") | to_json }}
{% endif %}
{% if n8n_webhook_url | length > 0 %}
      WEBHOOK_URL: {{ n8n_webhook_url | string | replace("$", "$$") | to_json }}
{% endif %}
{% if n8n_mcp_base_url | length > 0 %}
      N8N_MCP_BASE_URL: {{ n8n_mcp_base_url | string | replace("$", "$$") | to_json }}
{% endif %}
    healthcheck:
      test:
        - "CMD"
        - "node"
        - "-e"
        - >-
          fetch('http://127.0.0.1:{{ n8n_internal_port }}/healthz')
          .then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1));
      interval: "30s"
      timeout: "10s"
      retries: 10
      start_period: "90s"
{%- endmacro %}

{{- compose() }}
