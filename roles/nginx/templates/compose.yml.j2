{%- macro compose() -%}
# SPDX-FileCopyrightText: Copyright © 2026, Jared W. Cook
# SPDX-License-Identifier: AGPL-3.0-or-later
# Auto-generated by Ansible for {{ ansible_fqdn | default(inventory_hostname) }}
# Manual edits will be overwritten.
---
services:
  # -------------------------------------------------------------------------
  # Central Nginx Reverse Proxy
  # -------------------------------------------------------------------------
  nginx:
    image: {{ nginx_image | default('docker.io/library/nginx:1.30.7-alpine3.24') | to_json }}
    container_name: {{ nginx_container_name | default('nginx') | to_json }}
    pull_policy: {{ nginx_pull_policy | default('missing') | to_json }}
    restart: {{ nginx_restart_policy | default('unless-stopped') | to_json }}
    read_only: true
    cap_drop:
      - "ALL"
    security_opt:
      - "no-new-privileges:true"
    init: true
    ports:
      - {{ ((nginx_host_bind_ip | default('0.0.0.0')) ~ ':' ~
          (nginx_http_external_port | default(8080) | string) ~ ':' ~
          (nginx_http_internal_port | default(8080) | string)) | to_json }}
      - {{ ((nginx_host_bind_ip | default('0.0.0.0')) ~ ':' ~
          (nginx_https_external_port | default(8443) | string) ~ ':' ~
          (nginx_https_internal_port | default(8443) | string)) | to_json }}
    volumes:
      - {{ ((nginx_file.config | default('/opt/nginx/config/nginx.conf')) ~
          ':/etc/nginx/nginx.conf:ro') | to_json }}
      - {{ ((nginx_directory.certs | default('/opt/nginx/certs')) ~
          ':/etc/nginx/tls:ro') | to_json }}
    tmpfs:
      - "/tmp:rw,nosuid,nodev,size=64m,mode=1777"
    healthcheck:
      test:
        - "CMD"
        - "wget"
        - "-q"
        - "-O"
        - "/dev/null"
        - "http://127.0.0.1:{{ nginx_http_internal_port | default(8080) }}/nginx-health"
      interval: "30s"
      timeout: "5s"
      retries: 3
      start_period: "10s"
    networks:
      - "proxy"

networks:
  proxy:
    external: true
    name: {{ nginx_proxy_network_name | default('jcook3701_proxy') | to_json }}
{%- endmacro %}
{{- compose() }}
