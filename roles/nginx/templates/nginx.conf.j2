{%- macro unifi_inform_location() -%}
        location /inform {
            set $unifi_target "http://{{ nginx_unifi_inform_upstream_host | default('unifi-network') }}:{{
                nginx_unifi_inform_upstream_port | default(8080) }}";
            proxy_pass $unifi_target;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto http;
            proxy_connect_timeout {{ nginx_proxy_connect_timeout | default('10s') }};
            proxy_read_timeout {{ nginx_proxy_read_timeout | default('3600s') }};
            proxy_send_timeout {{ nginx_proxy_send_timeout | default('3600s') }};
        }
{%- endmacro %}
{%- macro nginx_config() -%}
# Auto-generated by Ansible. Manual edits will be overwritten.
user nginx;
worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;
    keepalive_timeout 65;
    client_max_body_size {{ nginx_client_max_body_size | default('100m') }};
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;
    resolver 127.0.0.11 valid=30s ipv6=off;
    resolver_timeout 5s;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # Default HTTP listener, including optional UniFi device communication.
    server {
        listen {{ nginx_http_internal_port | default(8080) }} default_server;
        server_name _;

        location = /nginx-health {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }
{% if nginx_unifi_inform_enabled | default(false) | bool %}
{{ unifi_inform_location() }}
{% endif %}
        location / {
            return 404;
        }
    }

    # Default TLS listener rejects unmatched hostnames.
    server {
        listen {{ nginx_https_internal_port | default(8443) }} ssl default_server;
        server_name _;
        ssl_certificate /etc/nginx/tls/server.crt;
        ssl_certificate_key /etc/nginx/tls/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        return 444;
    }

{% for site_name, site in (nginx_proxy_sites | default({})).items() %}
{% if site.enabled | default(false) | bool %}
    # Route: {{ site_name }}
    server {
        listen {{ nginx_http_internal_port | default(8080) }};
        server_name {{ site.server_name }};
{% if nginx_unifi_inform_enabled | default(false) | bool %}
{{ unifi_inform_location() }}
{% endif %}
        location / {
            return 308 https://$host:{{ nginx_https_external_port | default(8443) }}$request_uri;
        }
    }

    server {
        listen {{ nginx_https_internal_port | default(8443) }} ssl;
        server_name {{ site.server_name }};
        ssl_certificate /etc/nginx/tls/server.crt;
        ssl_certificate_key /etc/nginx/tls/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;

        location / {
            set $proxy_target "{{ site.upstream_scheme | default('http') }}://{{
                site.upstream_host }}:{{ site.upstream_port }}";
            proxy_pass $proxy_target;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Port {{ nginx_https_external_port | default(8443) }};
            proxy_connect_timeout {{ nginx_proxy_connect_timeout | default('10s') }};
            proxy_read_timeout {{ nginx_proxy_read_timeout | default('3600s') }};
            proxy_send_timeout {{ nginx_proxy_send_timeout | default('3600s') }};
{% if site.websocket | default(false) | bool %}
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
{% endif %}
{% if (site.upstream_scheme | default('http')) == 'https' %}
            proxy_ssl_server_name on;
            proxy_ssl_verify {{ 'on' if site.proxy_ssl_verify | default(false) | bool else 'off' }};
{% if site.proxy_ssl_verify | default(false) | bool %}
            proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
            proxy_ssl_verify_depth 3;
{% endif %}
{% endif %}
        }
    }
{% endif %}
{% endfor %}
}
{%- endmacro %}
{{- nginx_config() }}
