{%- macro compose() -%}
# Auto-generated by Ansible for {{ ansible_fqdn }}
# Manual edits will be overwritten.
# Service credentials are loaded from the persistent, root-only .env file.
services:
  # -----------------------------------------------------------------------
  # Ollama Backend
  # -----------------------------------------------------------------------
  ollama:
    image: {{ ollama_backend_image | to_json }}
    container_name: {{ ollama_backend_container_name | to_json }}
    pull_policy: {{ ollama_pull_policy | to_json }}
    tty: {{ ollama_backend_tty | bool | lower }}
    restart: {{ ollama_restart_policy | to_json }}
    ports:
      - "{{ ollama_backend_bind_ip }}:{{ ollama_external_port }}:{{ ollama_internal_port }}"
    volumes:
      - "{{ ollama_directory.ollama }}:/root/.ollama"
    environment:
      OLLAMA_HOST: "{{ ollama_internal_bind_ip }}:{{ ollama_internal_port }}"
      OLLAMA_KEEP_ALIVE: {{ ollama_backend_keep_alive | to_json }}
{% if ollama_enable_gpu | bool %}
      NVIDIA_DRIVER_CAPABILITIES: {{ ollama_nvidia_driver_capabilities | to_json }}
    runtime: {{ ollama_docker_runtime | to_json }}
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
{% if ollama_gpu_device_ids | length > 0 and 'all' not in ollama_gpu_device_ids %}
              device_ids: {{ ollama_gpu_device_ids | to_json }}
{% else %}
              count: {{ ollama_gpu_device_count }}
{% endif %}
              capabilities: {{ ollama_gpu_capabilities | to_json }}
{% endif %}
    healthcheck:
      test: ["CMD", "ollama", "list"]
      interval: 30s
      timeout: 10s
      retries: 6
      start_period: 30s
    networks:
      - ollama

{% if ollama_manage_web_ui | bool %}
  # -----------------------------------------------------------------------
  # Open WebUI Frontend
  # -----------------------------------------------------------------------
  ollama-webui:
    image: {{ ollama_webui_image | to_json }}
    container_name: {{ ollama_webui_container_name | to_json }}
    pull_policy: {{ ollama_pull_policy | to_json }}
    restart: {{ ollama_restart_policy | to_json }}
    depends_on:
      ollama:
        condition: service_healthy
{% if ollama_manage_searxng | bool %}
      searxng:
        condition: service_healthy
{% endif %}
    ports:
      - "{{ ollama_webui_bind_ip }}:{{ ollama_webui_external_port }}:{{ ollama_webui_internal_port }}"
    volumes:
      - "{{ ollama_directory.open_webui }}:/app/backend/data"
    environment:
      ENV: {{ ollama_webui_environment | to_json }}
      WEBUI_NAME: {{ ollama_webui_name | to_json }}
      WEBUI_URL: {{ ollama_webui_url | to_json }}
      WEBUI_AUTH: {{ (ollama_webui_auth | bool | lower) | to_json }}
{% if ollama_webui_secret_key | length > 0 %}
      WEBUI_SECRET_KEY: {{ ollama_webui_secret_key | to_json }}
{% else %}
      WEBUI_SECRET_KEY: "${OLLAMA_WEBUI_SECRET_KEY:?Missing persistent Open WebUI secret}"
{% endif %}
      ENABLE_SIGNUP: {{ (ollama_webui_enable_signup | bool | lower) | to_json }}
      OLLAMA_BASE_URLS: {{ ollama_backend_internal_url | to_json }}
      NO_PROXY: {{ ollama_webui_no_proxy | to_json }}
      ENABLE_WEB_SEARCH: {{ (ollama_webui_enable_rag_web_search | bool | lower) | to_json }}
      WEB_SEARCH_ENGINE: {{ ollama_webui_rag_web_search_engine | to_json }}
      SEARXNG_QUERY_URL: {{ ollama_webui_searxng_query_url | to_json }}
      SEARXNG_LANGUAGE: {{ ollama_webui_searxng_language | to_json }}
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{ ollama_webui_internal_port }}/health', timeout=3)"
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 90s
    networks:
      - ollama
{% endif %}

{% if ollama_manage_n8n | bool %}
  # -----------------------------------------------------------------------
  # n8n Workflow Automation
  # -----------------------------------------------------------------------
  n8n:
    image: {{ ollama_n8n_image | to_json }}
    container_name: {{ ollama_n8n_container_name | to_json }}
    pull_policy: {{ ollama_pull_policy | to_json }}
    restart: {{ ollama_restart_policy | to_json }}
    ports:
      - "{{ ollama_n8n_bind_ip }}:{{ ollama_n8n_external_port }}:{{ ollama_n8n_internal_port }}"
    volumes:
      - "{{ ollama_directory.n8n }}:/home/node/.n8n"
    environment:
      N8N_HOST: {{ (ollama_n8n_host if ollama_n8n_host | length > 0 else ansible_fqdn) | to_json }}
      N8N_PORT: {{ ollama_n8n_internal_port | string | to_json }}
      N8N_LISTEN_ADDRESS: {{ ollama_n8n_listen_address | to_json }}
      N8N_PROTOCOL: {{ ollama_n8n_protocol | to_json }}
      N8N_SECURE_COOKIE: {{ (ollama_n8n_secure_cookie | bool | lower) | to_json }}
      N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS: "true"
      N8N_PROXY_HOPS: {{ ollama_n8n_proxy_hops | string | to_json }}
      GENERIC_TIMEZONE: {{ ollama_n8n_timezone | to_json }}
      TZ: {{ ollama_n8n_timezone | to_json }}
{% if ollama_n8n_encryption_key | length > 0 %}
      N8N_ENCRYPTION_KEY: {{ ollama_n8n_encryption_key | to_json }}
{% endif %}
{% if ollama_n8n_editor_base_url | length > 0 %}
      N8N_EDITOR_BASE_URL: {{ ollama_n8n_editor_base_url | to_json }}
{% endif %}
{% if ollama_n8n_webhook_url | length > 0 %}
      WEBHOOK_URL: {{ ollama_n8n_webhook_url | to_json }}
{% endif %}
{% if ollama_n8n_mcp_base_url | length > 0 %}
      N8N_MCP_BASE_URL: {{ ollama_n8n_mcp_base_url | to_json }}
{% endif %}
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - "require('http').get('http://127.0.0.1:{{ ollama_n8n_internal_port }}/healthz', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 90s
    networks:
      - ollama
{% endif %}

{% if ollama_manage_mcp | bool %}
  # -----------------------------------------------------------------------
  # Docker MCP Gateway
  # -----------------------------------------------------------------------
  ollama-mcp-gateway:
    image: {{ ollama_mcp_gateway_image | to_json }}
    container_name: {{ ollama_mcp_gateway_container_name | to_json }}
    pull_policy: {{ ollama_pull_policy | to_json }}
    restart: {{ ollama_restart_policy | to_json }}
    command:
      - "--servers={{ ollama_mcp_gateway_servers | join(',') }}"
      - "--transport={{ ollama_mcp_gateway_transport }}"
      - "--port={{ ollama_mcp_gateway_internal_port }}"
    environment:
      DOCKER_MCP_IN_CONTAINER: "1"
{% if ollama_mcp_gateway_auth_token | length > 0 %}
      MCP_GATEWAY_AUTH_TOKEN: {{ ollama_mcp_gateway_auth_token | to_json }}
{% else %}
      MCP_GATEWAY_AUTH_TOKEN: "${OLLAMA_MCP_GATEWAY_AUTH_TOKEN:?Missing persistent MCP gateway token}"
{% endif %}
    ports:
      - "{{ ollama_mcp_gateway_bind_ip }}:{{ ollama_mcp_gateway_external_port }}:{{ ollama_mcp_gateway_internal_port }}"
    volumes:
      # WARNING: A writable Docker socket allows host-level Docker control.
      - "/var/run/docker.sock:/var/run/docker.sock"
    security_opt:
      - no-new-privileges:true
    networks:
      - ollama
{% endif %}

{% if ollama_manage_mcp_inspector | bool %}
  # -----------------------------------------------------------------------
  # MCP Inspector Web Interface
  # -----------------------------------------------------------------------
  ollama-mcp-inspector:
    image: {{ ollama_mcp_inspector_image | to_json }}
    container_name: {{ ollama_mcp_inspector_container_name | to_json }}
    pull_policy: {{ ollama_pull_policy | to_json }}
    restart: {{ ollama_restart_policy | to_json }}
{% if ollama_manage_mcp | bool %}
    depends_on:
      - ollama-mcp-gateway
{% endif %}
    ports:
      - "{{ ollama_mcp_inspector_bind_ip }}:{{ ollama_mcp_inspector_external_port }}:{{ ollama_mcp_inspector_internal_port }}"
      - "{{ ollama_mcp_inspector_bind_ip }}:{{ ollama_mcp_inspector_sandbox_port }}:{{ ollama_mcp_inspector_sandbox_port }}"
      - "{{ ollama_mcp_inspector_bind_ip }}:{{ ollama_mcp_inspector_app_origin_port }}:{{ ollama_mcp_inspector_app_origin_port }}"
    volumes:
      - "{{ ollama_directory.mcp_inspector }}:/home/node/.mcp-inspector"
      - "{{ ollama_file.mcp_inspector_secret_key }}:/run/secrets/mcp_inspector_secret_key:ro"
    environment:
      HOST: "0.0.0.0"
      CLIENT_PORT: {{ ollama_mcp_inspector_internal_port | string | to_json }}
      MCP_SANDBOX_PORT: {{ ollama_mcp_inspector_sandbox_port | string | to_json }}
      MCP_APP_ORIGIN_PORT: {{ ollama_mcp_inspector_app_origin_port | string | to_json }}
      MCP_AUTO_OPEN_ENABLED: "false"
      DANGEROUSLY_BIND_ALL_INTERFACES: "true"
      MCP_INSPECTOR_SECRET_KEY_FILE: "/run/secrets/mcp_inspector_secret_key"
{% if ollama_mcp_inspector_allowed_origins | length > 0 %}
      ALLOWED_ORIGINS: {{ ollama_mcp_inspector_allowed_origins | join(',') | to_json }}
{% endif %}
    security_opt:
      - no-new-privileges:true
    networks:
      - ollama
{% endif %}

{% if ollama_manage_searxng | bool %}
  # -----------------------------------------------------------------------
  # SearXNG Valkey Backend
  # -----------------------------------------------------------------------
  searxng-valkey:
    image: {{ ollama_searxng_valkey_image | to_json }}
    container_name: {{ ollama_searxng_valkey_container_name | to_json }}
    pull_policy: {{ ollama_pull_policy | to_json }}
    restart: {{ ollama_restart_policy | to_json }}
    command: ["valkey-server", "--save", "300", "1", "--save", "60", "1000", "--loglevel", "warning"]
    volumes:
      - "{{ ollama_directory.searxng_valkey }}:/data"
    healthcheck:
      test: ["CMD", "valkey-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 12
    networks:
      - ollama

  # -----------------------------------------------------------------------
  # SearXNG Search Engine
  # -----------------------------------------------------------------------
  searxng:
    image: {{ ollama_searxng_image | to_json }}
    container_name: {{ ollama_searxng_container_name | to_json }}
    pull_policy: {{ ollama_pull_policy | to_json }}
    restart: {{ ollama_restart_policy | to_json }}
    depends_on:
      searxng-valkey:
        condition: service_healthy
    ports:
      - "{{ ollama_searxng_bind_ip }}:{{ ollama_searxng_external_port }}:{{ ollama_searxng_internal_port }}"
    volumes:
      - "{{ ollama_directory.searxng_config }}:/etc/searxng"
      - "{{ ollama_directory.searxng_cache }}:/var/cache/searxng"
    environment:
      SEARXNG_PORT: {{ ollama_searxng_internal_port | string | to_json }}
{% if ollama_searxng_secret_key | length > 0 %}
      SEARXNG_SECRET: {{ ollama_searxng_secret_key | to_json }}
{% else %}
      SEARXNG_SECRET: "${OLLAMA_SEARXNG_SECRET_KEY:?Missing persistent SearXNG secret}"
{% endif %}
      SEARXNG_VALKEY_URL: {{ ollama_searxng_valkey_url | to_json }}
      FORCE_OWNERSHIP: "true"
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - >-
          import urllib.request;
          urllib.request.urlopen(
          'http://127.0.0.1:{{ ollama_searxng_internal_port }}/healthz', timeout=3)
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 45s
    networks:
      - ollama
{% endif %}

networks:
  ollama:
    driver: bridge
    external: false
{%- endmacro %}

{{- compose() }}
