{%- macro compose() -%}
# Auto-generated by Ansible for {{ ansible_fqdn }}
# Manual edits will be overwritten.

services:
  # -----------------------------------------------------------------------
  # Ollama Backend
  # -----------------------------------------------------------------------
  ollama:
    image: "{{ ollama_backend_image | default('docker.io/ollama/ollama:latest') }}"
    container_name: "{{ ollama_backend_container_name | default('ollama') }}"
    pull_policy: always
    tty: {{ ollama_backend_tty | default(true) | bool | lower }}
    restart: "{{ ollama_restart_policy | default('unless-stopped') }}"
    ports:
      - "{{ ollama_host_bind_ip | default('127.0.0.1') }}:{{ ollama_external_port | default(11434) }}:{{ ollama_internal_port | default('11434') }}"
    volumes:
      - "{{ ollama_directory.ollama | default('/opt/ollama') }}:/root/.ollama"
    environment:
      OLLAMA_HOST: "{{ ollama_internal_bind_ip | default('0.0.0.0') }}:{{ ollama_internal_port | default(11434) }}"
      OLLAMA_KEEP_ALIVE: "{{ ollama_backend_keep_alive | default('24h') }}"
{% if ollama_enable_gpu | bool %}
      NVIDIA_DRIVER_CAPABILITIES: "{{ ollama_nvidia_driver_capabilities | default('compute,utility') }}"
    runtime: "{{ ollama_docker_runtime | default('nvidia') }}"
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
{% if ollama_gpu_device_ids | length > 0 %}
              device_ids: {{ ollama_gpu_device_ids | default(['all']) | to_json }}
{% else %}
              count: {{ ollama_gpu_device_count | default('all') | to_json }}
{% endif %}
              capabilities: {{ ollama_gpu_capabilities | default(['gpu', 'compute', 'utility']) | to_json }}
{% endif %}
    networks:
      - ollama

{% if ollama_manage_web_ui | default(true) | bool %}
  # -----------------------------------------------------------------------
  # Open WebUI Frontend
  # -----------------------------------------------------------------------
  ollama-webui:
    image: "{{ ollama_webui_image | default('ghcr.io/open-webui/open-webui:main') }}"
    container_name: "{{ ollama_webui_container_name | default('ollama-webui') }}"
    pull_policy: always
    restart: "{{ ollama_restart_policy | default('unless-stopped') }}"
    depends_on:
      - ollama
{% if ollama_manage_searxng | default(false) | bool %}
      - searxng
{% endif %}
    ports:
      - "{{ ollama_host_bind_ip | default('127.0.0.1') }}:{{ ollama_webui_external_port | default(3000) }}:{{ ollama_webui_internal_port | default('8080') }}"
    volumes:
      - "{{ ollama_directory.open_webui | default('/opt/open-webui') }}:/app/backend/data"
    environment:
      # Application Environment
      ENV: "{{ ollama_webui_environment | default('prod') }}"
      WEBUI_NAME: "{{ ollama_webui_name | default('Ollama WebUI') }}"
      WEBUI_URL: "{{ ollama_webui_url | default('') }}"
      # Authentication & Registration
      WEBUI_AUTH: "{{ ollama_webui_auth | default(true) | bool | lower }}"
      WEBUI_SECRET_KEY: {{ ollama_webui_secret_key | default('change_this_to_a_secure_random_string_in_production') | to_json }}
      ENABLE_SIGNUP: "{{ ollama_webui_enable_signup | default(false) | bool | lower }}"
      # Ollama Backend Connection
      OLLAMA_BASE_URLS: "{{ ollama_backend_internal_url | default('http://ollama:11434') }}"
      # Proxy Configuration
      NO_PROXY: "{{ ollama_webui_no_proxy | default('') }}"
      # RAG & Web Search
      ENABLE_WEB_SEARCH: "{{ ollama_webui_enable_rag_web_search | default(true) | bool | lower }}"
      WEB_SEARCH_ENGINE: "{{ ollama_webui_rag_web_search_engine | default('searxng') }}"
      SEARXNG_QUERY_URL: "{{ ollama_webui_searxng_query_url | default('http://searxng:8080/search') }}"
      SEARXNG_LANGUAGE: "{{ ollama_webui_searxng_language | default('all') }}"
    networks:
      - ollama
{% endif %}

{% if ollama_manage_n8n | default(false) | bool %}
  # -----------------------------------------------------------------------
  # n8n Workflow Automation
  # -----------------------------------------------------------------------
  n8n:
    image: "{{ ollama_n8n_image | default('docker.n8n.io/n8nio/n8n:latest') }}"
    container_name: "{{ ollama_n8n_container_name | default('ollama-n8n') }}"
    pull_policy: always
    restart: "{{ ollama_restart_policy | default('unless-stopped') }}"
    ports:
      - "{{ ollama_host_bind_ip | default('127.0.0.1') }}:{{ ollama_n8n_external_port | default(5678) }}:{{ ollama_n8n_internal_port | default(5678) }}"
    volumes:
      - "{{ ollama_directory.n8n | default('/opt/ollama/n8n') }}:/home/node/.n8n"
    environment:
      # Application Address
      N8N_HOST: "{{ ollama_n8n_host | default(ansible_fqdn, true) }}"
      N8N_PORT: "{{ ollama_n8n_internal_port | default(5678) }}"
      N8N_LISTEN_ADDRESS: "{{ ollama_n8n_listen_address | default('0.0.0.0') }}"
      N8N_PROTOCOL: "{{ ollama_n8n_protocol | default('http') }}"

      # HTTP Deployment Security
      N8N_SECURE_COOKIE: "{{ ollama_n8n_secure_cookie | default(false) | bool | lower }}"
      N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS: "true"
      N8N_PROXY_HOPS: "{{ ollama_n8n_proxy_hops | default(0) }}"

      # Timezone
      GENERIC_TIMEZONE: "{{ ollama_n8n_timezone | default('America/Los_Angeles') }}"
      TZ: "{{ ollama_n8n_timezone | default('America/Los_Angeles') }}"
{% if ollama_n8n_encryption_key | default('') | length > 0 %}
      # Optional Explicit Encryption Key
      N8N_ENCRYPTION_KEY: {{ ollama_n8n_encryption_key | to_json }}
{% endif %}
{% if ollama_n8n_editor_base_url | default('') | length > 0 %}
      N8N_EDITOR_BASE_URL: "{{ ollama_n8n_editor_base_url }}"
{% endif %}
{% if ollama_n8n_webhook_url | default('') | length > 0 %}
      WEBHOOK_URL: "{{ ollama_n8n_webhook_url }}"
{% endif %}
{% if ollama_n8n_mcp_base_url | default('') | length > 0 %}
      N8N_MCP_BASE_URL: "{{ ollama_n8n_mcp_base_url }}"
{% endif %}
    networks:
      - ollama
{% endif %}

{% if ollama_manage_mcp | default(false) | bool %}
  # -----------------------------------------------------------------------
  # Docker MCP Gateway
  # -----------------------------------------------------------------------
  ollama-mcp-gateway:
    image: "{{ ollama_mcp_gateway_image | default('docker/mcp-gateway:latest') }}"
    container_name: "{{ ollama_mcp_gateway_container_name | default('ollama-mcp-gateway') }}"
    pull_policy: always
    restart: "{{ ollama_restart_policy | default('unless-stopped') }}"
    command:
      - "--servers={{ ollama_mcp_gateway_servers | default(['duckduckgo']) | join(',') }}"
      - "--transport={{ ollama_mcp_gateway_transport | default('streaming') }}"
      - "--port={{ ollama_mcp_gateway_internal_port | default(8811) }}"
    environment:
      # Allow the gateway to run against Docker Engine without Docker Desktop.
      DOCKER_MCP_IN_CONTAINER: "1"
{% if ollama_mcp_gateway_auth_token | default('') | length > 0 %}
      MCP_GATEWAY_AUTH_TOKEN: {{ ollama_mcp_gateway_auth_token | to_json }}
{% endif %}
    ports:
      - "{{ ollama_host_bind_ip | default('127.0.0.1') }}:{{ ollama_mcp_gateway_external_port | default(8811) }}:{{ ollama_mcp_gateway_internal_port | default(8811) }}"
    volumes:
      # Required by Docker MCP Gateway to launch and manage MCP server containers.
      - "/var/run/docker.sock:/var/run/docker.sock"
    networks:
      - ollama
{% endif %}

{% if ollama_manage_searxng | default(false) | bool %}
  # -----------------------------------------------------------------------
  # SearXNG Valkey Backend
  # -----------------------------------------------------------------------
  searxng-valkey:
    image: "{{ ollama_searxng_valkey_image | default('docker.io/valkey/valkey:9-alpine') }}"
    container_name: "{{ ollama_searxng_valkey_container_name | default('searxng-valkey') }}"
    pull_policy: always
    restart: "{{ ollama_restart_policy | default('unless-stopped') }}"
    command:
      - "valkey-server"
      - "--save"
      - "300"
      - "1"
      - "--save"
      - "60"
      - "1000"
      - "--loglevel"
      - "warning"
    volumes:
      - "{{ ollama_directory.searxng_valkey | default('/opt/ollama/searxng/valkey') }}:/data"
    healthcheck:
      test: ["CMD", "valkey-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 12
    networks:
      - ollama

  # -----------------------------------------------------------------------
  # SearXNG Search Engine
  # -----------------------------------------------------------------------
  searxng:
    image: "{{ ollama_searxng_image | default('docker.io/searxng/searxng:latest') }}"
    container_name: "{{ ollama_searxng_container_name | default('searxng') }}"
    pull_policy: always
    restart: "{{ ollama_restart_policy | default('unless-stopped') }}"
    depends_on:
      searxng-valkey:
        condition: service_healthy
    ports:
      - "{{ ollama_host_bind_ip | default('127.0.0.1') }}:{{ ollama_searxng_external_port | default(8081) }}:{{ ollama_searxng_internal_port | default(8080) }}"
    volumes:
      - "{{ ollama_directory.searxng_config | default('/opt/ollama/searxng/config') }}:/etc/searxng"
      - "{{ ollama_directory.searxng_cache | default('/opt/ollama/searxng/cache') }}:/var/cache/searxng"
    environment:
      SEARXNG_PORT: "{{ ollama_searxng_internal_port | default(8080) }}"
      SEARXNG_SECRET: {{ ollama_searxng_secret_key | to_json }}
      SEARXNG_VALKEY_URL: "{{ ollama_searxng_valkey_url | default('valkey://searxng-valkey:6379/0') }}"
      FORCE_OWNERSHIP: "true"
    networks:
      - ollama
{% endif %}

# -------------------------------------------------------------------------
# Container Networking
# -------------------------------------------------------------------------
networks:
  ollama:
    driver: bridge
    external: false
{%- endmacro %}

{{- compose() -}}
