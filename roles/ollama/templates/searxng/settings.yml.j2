{%- macro searxng_settings() -%}
# Auto-generated by Ansible for {{ ansible_fqdn }}
# Manual edits will be overwritten.
---
use_default_settings: true

general:
  debug: false
  instance_name: {{ ollama_searxng_instance_name | to_json }}

search:
  safe_search: {{ ollama_searxng_safe_search | int }}
  formats:
    - html
    - json

server:
  # SEARXNG_SECRET is passed via Docker Compose environment.
  limiter: {{ ollama_searxng_limiter | bool | lower }}
  image_proxy: {{ ollama_searxng_image_proxy | bool | lower }}

valkey:
  url: {{ ollama_searxng_valkey_url | to_json }}
{%- endmacro %}

{{- searxng_settings() }}
