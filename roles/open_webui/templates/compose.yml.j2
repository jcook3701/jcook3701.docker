{%- macro compose() -%}
{%- set host_ip = '[' ~ open_webui_bind_ip ~ ']' if ':' in open_webui_bind_ip else open_webui_bind_ip -%}
# SPDX-FileCopyrightText: Copyright © 2026, Jared W. Cook
# SPDX-License-Identifier: AGPL-3.0-or-later
# Auto-generated by Ansible for {{ ansible_fqdn | default(inventory_hostname) }}
# Manual edits will be overwritten.
---
services:
  open-webui:
    image: {{ open_webui_image | to_json }}
    container_name: {{ open_webui_container_name | to_json }}
    pull_policy: {{ open_webui_pull_policy | to_json }}
    restart: {{ open_webui_restart_policy | to_json }}
    ports:
      - {{ (host_ip ~ ":" ~ open_webui_external_port ~ ":" ~ open_webui_internal_port) | to_json }}
    volumes:
      - {{ (open_webui_directory.data ~ ":/app/backend/data") | to_json }}
    extra_hosts:
      - "host.docker.internal:host-gateway"
    env_file:
      - {{ open_webui_file.secrets | to_json }}
    environment:
      WEBUI_NAME: {{ open_webui_name | string | replace("$", "$$") | to_json }}
      WEBUI_URL: {{ open_webui_url | string | replace("$", "$$") | to_json }}
      WEBUI_AUTH: "true"
{% if open_webui_secret_key | length > 0 %}
      WEBUI_SECRET_KEY: {{ open_webui_secret_key | string | replace("$", "$$") | to_json }}
{% endif %}
      ENABLE_SIGNUP: {{ (open_webui_enable_signup | bool | lower) | string | replace("$", "$$") | to_json }}
      OLLAMA_BASE_URLS: {{ open_webui_ollama_url | string | replace("$", "$$") | to_json }}
      NO_PROXY: "localhost,127.0.0.1,ollama,searxng,host.docker.internal"
      ENABLE_WEB_SEARCH: {{ (open_webui_enable_web_search | bool | lower) | string | replace("$", "$$") | to_json }}
{% if open_webui_enable_web_search | bool %}
      WEB_SEARCH_ENGINE: "searxng"
      SEARXNG_QUERY_URL: {{ open_webui_searxng_query_url | string | replace("$", "$$") | to_json }}
      SEARXNG_LANGUAGE: {{ open_webui_searxng_language | string | replace("$", "$$") | to_json }}
{% endif %}
    healthcheck:
      test:
        - "CMD"
        - "python"
        - "-c"
        - >-
          import urllib.request;
          urllib.request.urlopen('http://127.0.0.1:{{ open_webui_internal_port }}/health', timeout=3)
      interval: "30s"
      timeout: "10s"
      retries: 10
      start_period: "90s"
{% if open_webui_shared_network | length > 0 %}
    networks:
      - "default"
      - "shared"
{% endif %}
{% if open_webui_shared_network | length > 0 %}

networks:
  shared:
    name: {{ open_webui_shared_network | to_json }}
    external: true
{% endif %}
{%- endmacro %}

{{- compose() }}
