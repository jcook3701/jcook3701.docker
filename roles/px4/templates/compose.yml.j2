{% macro docker_compose() -%}
# SPDX-FileCopyrightText: Copyright © 2026, Jared Cook
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Auto-generated by Ansible for {{ ansible_fqdn | default(inventory_hostname) }}
# Manual edits will be overwritten.
---
services:
  # -------------------------------------------------------------------------
  # PX4 Firmware Development Toolchain
  # -------------------------------------------------------------------------
  px4:
    image: {{ px4_image | default('docker.io/px4io/px4-dev:v1.17.0') | to_json }}
    container_name: {{ px4_container_name | default('px4') | to_json }}
    pull_policy: {{ px4_pull_policy | default('always') | to_json }}
    restart: {{ px4_restart_policy | default('unless-stopped') | to_json }}
    init: true
    tty: {{ px4_tty | default(true) | bool | lower }}
    stdin_open: {{ px4_stdin_open | default(true) | bool | lower }}
    command: {{ px4_command | default(['sleep', 'infinity']) | to_json }}
{% if px4_container_user | default('') | length > 0 %}
    user: {{ px4_container_user | to_json }}
{% endif %}
    network_mode: {{ px4_network_mode | default('host') | to_json }}
    ipc: {{ px4_ipc_mode | default('private') | to_json }}
    working_dir: "/workspace"
    volumes:
      - {{ ((px4_directory.workspace | default('/opt/px4/workspace')) ~ ':/workspace') | to_json }}
      - {{ ((px4_directory.ccache | default('/opt/px4/ccache')) ~ ':/root/.ccache') | to_json }}
{% for volume in px4_extra_volumes | default([]) %}
      - {{ volume | to_json }}
{% endfor %}
{% if px4_devices | default([]) | length > 0 %}
    devices:
{% for device in px4_devices %}
      - {{ device | to_json }}
{% endfor %}
{% endif %}
{% if px4_extra_environment | default({}) | length > 0 %}
    environment:
{% for env_name, env_value in (px4_extra_environment | default({})).items() %}
      {{ env_name }}: {{ env_value | string | to_json }}
{% endfor %}
{% endif %}

{% if px4_manage_sitl | default(false) | bool %}
  # -------------------------------------------------------------------------
  # Optional PX4 SIH Software-in-the-Loop Simulator
  # -------------------------------------------------------------------------
  px4-sitl:
    image: {{ px4_sitl_image | default('docker.io/px4io/px4-sitl:latest') | to_json }}
    container_name: {{ px4_sitl_container_name | default('px4-sitl') | to_json }}
    pull_policy: {{ px4_pull_policy | default('always') | to_json }}
    restart: {{ px4_restart_policy | default('unless-stopped') | to_json }}
    init: true
    tty: true
    stdin_open: true
    network_mode: "host"
{% if px4_sitl_model | default('') | length > 0 or px4_sitl_extra_environment | default({}) | length > 0 %}
    environment:
{% if px4_sitl_model | default('') | length > 0 %}
      PX4_SIM_MODEL: {{ px4_sitl_model | to_json }}
{% endif %}
{% for env_name, env_value in (px4_sitl_extra_environment | default({})).items() %}
      {{ env_name }}: {{ env_value | string | to_json }}
{% endfor %}
{% endif %}
{% if px4_sitl_extra_volumes | default([]) | length > 0 %}
    volumes:
{% for volume in px4_sitl_extra_volumes %}
      - {{ volume | to_json }}
{% endfor %}
{% endif %}
{% endif %}

{%- endmacro %}

{{- docker_compose() -}}
