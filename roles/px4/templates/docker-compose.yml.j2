{% macro docker_compose() -%}
version: '3.8'

services:
  px4_sitl:
    image: "{{ px4_docker_image }}:{{ px4_docker_tag }}"
    container_name: px4_sitl_headless
    network_mode: host
    user: "${UID}:${GID}"
    environment:
      - LOCAL_USER_ID=${UID}
    volumes:
      - {{ px4_dest_dir }}:/src/PX4-Autopilot:rw
    working_dir: /src/PX4-Autopilot
    command: bash -c "make px4_sitl none"
    restart: unless-stopped
{%- endmacro %}

{{- docker_compose() -}}
