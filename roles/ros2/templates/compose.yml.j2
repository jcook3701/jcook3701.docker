{%- macro compose() -%}
# SPDX-FileCopyrightText: Copyright © 2026, Jared W. Cook
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Auto-generated by Ansible for {{ ansible_fqdn | default(inventory_hostname) }}
# Manual edits will be overwritten.
---
services:
  # -------------------------------------------------------------------------
  # ROS 2 Development Container
  # -------------------------------------------------------------------------
  ros2:
    image: "{{ ros2_image | default('docker.io/library/ros:jazzy-ros-base') }}"
    container_name: "{{ ros2_container_name | default('ros2') }}"
    pull_policy: "{{ ros2_pull_policy | default('always') }}"
    restart: "{{ ros2_restart_policy | default('unless-stopped') }}"
    init: true
    tty: {{ ros2_tty | default(true) | bool | lower }}
    stdin_open: {{ ros2_stdin_open | default(true) | bool | lower }}
    command: {{ ros2_command | default(['sleep', 'infinity']) | to_json }}

    # DDS discovery and shared memory operate on the Linux host network.
    # Host network mode does not use Docker port mappings.
    network_mode: "{{ ros2_network_mode | default('host') }}"
    ipc: "{{ ros2_ipc_mode | default('host') }}"

    working_dir: "/ros2_ws"
    volumes:
      - "{{ ros2_directory.workspace | default('/opt/ros2/workspace') }}:/ros2_ws"
      - "{{ ros2_directory.ros_home | default('/opt/ros2/ros-home') }}:/root/.ros"
{% for volume in ros2_extra_volumes | default([]) %}
      - {{ volume | to_json }}
{% endfor %}
{% if ros2_devices | default([]) | length > 0 %}
    devices:
{% for device in ros2_devices %}
      - {{ device | to_json }}
{% endfor %}
{% endif %}
    environment:
      ROS_DOMAIN_ID: "{{ ros2_domain_id | default(0) }}"
      ROS_AUTOMATIC_DISCOVERY_RANGE: "{{ ros2_automatic_discovery_range | default('SUBNET') }}"
{% if ros2_rmw_implementation | default('') | length > 0 %}
      RMW_IMPLEMENTATION: "{{ ros2_rmw_implementation }}"
{% endif %}
{% if ros2_static_peers | default('') | length > 0 %}
      ROS_STATIC_PEERS: "{{ ros2_static_peers }}"
{% endif %}
{% for env_name, env_value in (ros2_extra_environment | default({})).items() %}
      {{ env_name }}: {{ env_value | string | to_json }}
{% endfor %}

{%- endmacro %}

{{- compose() -}}
