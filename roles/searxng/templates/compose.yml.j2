{%- macro compose() -%}
{%- set host_ip = '[' ~ searxng_bind_ip ~ ']' if ':' in searxng_bind_ip else searxng_bind_ip -%}
# SPDX-FileCopyrightText: Copyright © 2026, Jared W. Cook
# SPDX-License-Identifier: AGPL-3.0-or-later
# Auto-generated by Ansible for {{ ansible_fqdn | default(inventory_hostname) }}
# Manual edits will be overwritten.
---
services:
  searxng:
    image: {{ searxng_image | to_json }}
    container_name: {{ searxng_container_name | to_json }}
    pull_policy: {{ searxng_pull_policy | to_json }}
    restart: {{ searxng_restart_policy | to_json }}
    ports:
      - {{ (host_ip ~ ":" ~ searxng_external_port ~ ":" ~ searxng_internal_port) | to_json }}
    depends_on:
      searxng-valkey:
        condition: "service_healthy"
    volumes:
      - {{ (searxng_directory.config ~ ":/etc/searxng") | to_json }}
      - {{ (searxng_directory.cache ~ ":/var/cache/searxng") | to_json }}
    env_file:
      - {{ searxng_file.secrets | to_json }}
    environment:
      SEARXNG_PORT: {{ searxng_internal_port | string | replace("$", "$$") | to_json }}
{% if searxng_secret_key | length > 0 %}
      SEARXNG_SECRET: {{ searxng_secret_key | string | replace("$", "$$") | to_json }}
{% endif %}
      SEARXNG_VALKEY_URL: "valkey://searxng-valkey:6379/0"
      FORCE_OWNERSHIP: "true"
    healthcheck:
      test:
        - "CMD"
        - "python"
        - "-c"
        - >-
          import urllib.request;
          urllib.request.urlopen('http://127.0.0.1:{{ searxng_internal_port }}/healthz', timeout=3)
      interval: "30s"
      timeout: "10s"
      retries: 10
      start_period: "45s"
{% if searxng_shared_network | length > 0 %}
    networks:
      - "default"
      - "shared"
{% endif %}

  searxng-valkey:
    image: {{ searxng_valkey_image | to_json }}
    pull_policy: {{ searxng_pull_policy | to_json }}
    restart: {{ searxng_restart_policy | to_json }}
    command: ["valkey-server", "--save", "300", "1", "--save", "60", "1000", "--loglevel", "warning"]
    volumes:
      - {{ (searxng_directory.valkey ~ ":/data") | to_json }}
    healthcheck:
      test: ["CMD", "valkey-cli", "ping"]
      interval: "10s"
      timeout: "3s"
      retries: 12
{% if searxng_shared_network | length > 0 %}

networks:
  shared:
    name: {{ searxng_shared_network | to_json }}
    external: true
{% endif %}
{%- endmacro %}

{{- compose() }}
