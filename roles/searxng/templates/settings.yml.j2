{%- macro searxng_settings() -%}
# SPDX-FileCopyrightText: Copyright © 2026, Jared W. Cook
# SPDX-License-Identifier: AGPL-3.0-or-later
# Auto-generated by Ansible for {{ ansible_fqdn | default(inventory_hostname) }}
# Manual edits will be overwritten.
---
use_default_settings: true

general:
  debug: false
  instance_name: {{ searxng_instance_name | to_json }}

search:
  safe_search: {{ searxng_safe_search | int }}
  formats:
    - "html"
    - "json"

server:
  limiter: {{ searxng_limiter | bool | lower }}
  image_proxy: {{ searxng_image_proxy | bool | lower }}

valkey:
  url: "valkey://searxng-valkey:6379/0"
{%- endmacro %}

{{- searxng_settings() }}
