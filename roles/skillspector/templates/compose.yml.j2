{%- macro compose() -%}
{%- set scanner_user = skillspector_user | default('chat-gpt') -%}
{%- set scanner_group = skillspector_group | default('chat-gpt') -%}
{%- set scanner_uid = ansible_facts.getent_passwd[scanner_user][1] -%}
{%- set scanner_gid = ansible_facts.getent_group[scanner_group][1] -%}
# SPDX-FileCopyrightText: Copyright © 2026, Jared Cook
# SPDX-License-Identifier: AGPL-3.0-or-later
# Auto-generated by Ansible for {{ ansible_fqdn | default(inventory_hostname) }}
# Manual edits will be overwritten.
---
services:
  # -------------------------------------------------------------------------
  # On-demand SkillSpector security scanner
  # -------------------------------------------------------------------------
  skillspector:
    image: {{ skillspector_image_reference | default('skillspector-local:2.13.6') | to_json }}
    pull_policy: "never"
    restart: "no"
    profiles:
      - "scan"
    entrypoint:
      - "skillspector"
      - "scan"
{% if not (skillspector_enable_llm | default(false) | bool) %}
      - "--no-llm"
{% endif %}
    user: {{ (scanner_uid ~ ':' ~ scanner_gid) | to_json }}
    working_dir: "/scan"
    read_only: true
    cap_drop:
      - "ALL"
    security_opt:
      - "no-new-privileges:true"
    pids_limit: {{ skillspector_pids_limit | default(256) | int }}
    mem_limit: {{ skillspector_memory_limit | default('2g') | to_json }}
    cpus: {{ skillspector_cpu_limit | default('2.0') }}
    network_mode: {{ skillspector_network_mode | default('bridge') | to_json }}
    tmpfs:
      - "/tmp:rw,nosuid,nodev,size={{ skillspector_tmpfs_size | default('512m') }},mode=1777"
    environment:
      HOME: "/tmp"
      XDG_CACHE_HOME: "/tmp/.cache"
{% if skillspector_enable_llm | default(false) | bool %}
      SKILLSPECTOR_PROVIDER: "ollama"
      OLLAMA_BASE_URL: {{ skillspector_ollama_base_url | default('http://host.docker.internal:11434/v1') | to_json }}
      SKILLSPECTOR_MODEL: {{ skillspector_ollama_model | default('qwen2.5-coder:7b') | to_json }}
    extra_hosts:
      - "host.docker.internal:host-gateway"
{% endif %}
    volumes:
      - type: "bind"
        source: {{ skillspector_directory.scans | default('/home/chat-gpt/workbench/skill-scans') | to_json }}
        target: "/scan"
        read_only: true
        bind:
          create_host_path: false
          propagation: "rprivate"
      - type: "bind"
        source: {{ skillspector_directory.reports | default('/home/chat-gpt/workbench/skill-reports') | to_json }}
        target: "/reports"
        read_only: false
        bind:
          create_host_path: false
          propagation: "rprivate"
{%- endmacro %}
{{- compose() }}
