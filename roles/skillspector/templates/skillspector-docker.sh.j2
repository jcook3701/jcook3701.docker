# Managed by jcook3701.docker.skillspector. Manual changes will be overwritten.
set -Eeuo pipefail
umask 077

if [[ "$#" -lt 1 ]]; then
  printf 'Usage: %s TARGET [skillspector scan options...]\n' "$0" >&2
  printf 'Local targets must be under /scan (host: {{ skillspector_directory.scans }}).\n' >&2
  exit 2
fi

# This tool must run from an explicitly trusted Docker-capable host shell.
# Never expose the host Docker socket to Desktop Commander to invoke it.
args=(
  "run" "--rm"
  "--read-only"
  "--cap-drop=ALL"
  "--security-opt=no-new-privileges:true"
  "--pids-limit={{ skillspector_pids_limit }}"
  "--memory={{ skillspector_memory_limit }}"
  "--cpus={{ skillspector_cpu_limit }}"
  "--network={{ skillspector_network_mode }}"
  "--user={{ ansible_facts.getent_passwd[skillspector_user][1] }}:{{ ansible_facts.getent_group[skillspector_group][1] }}"
  "--tmpfs=/tmp:rw,nosuid,nodev,size={{ skillspector_tmpfs_size }},mode=1777"
  "--mount=type=bind,src={{ skillspector_directory.scans }},dst=/scan,readonly,bind-recursive=disabled"
  "--mount=type=bind,src={{ skillspector_directory.reports }},dst=/reports,bind-recursive=disabled"
  "--env=HOME=/tmp"
  "--env=XDG_CACHE_HOME=/tmp/.cache"
  "--workdir=/scan"
)

{% if skillspector_enable_llm | bool %}
# Optional LOCAL Ollama provider. No hosted API keys are passed into this image.
args+=(
  "--add-host=host.docker.internal:host-gateway"
  "--env=SKILLSPECTOR_PROVIDER=ollama"
  "--env=OLLAMA_BASE_URL={{ skillspector_ollama_base_url }}"
  "--env=SKILLSPECTOR_MODEL={{ skillspector_ollama_model }}"
)
exec docker "${args[@]}" "{{ skillspector_image_reference }}" "scan" "$@"
{% else %}
# Default: static analysis, with GitHub/OSV network access if bridge is enabled.
exec docker "${args[@]}" "{{ skillspector_image_reference }}" "scan" "--no-llm" "$@"
{% endif %}
