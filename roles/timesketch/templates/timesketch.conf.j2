{% macro timesketch_conf() -%}
# Auto-generated by Ansible for {{ ansible_fqdn }}
# Manual edits will be overwritten.

# Timesketch Application Configuration
# Core Settings
SECRET_KEY = "{{ timesketch_admin_password | password_hash('sha256') | b64encode }}"

# Database (PostgreSQL) Configuration
SQLALCHEMY_DATABASE_URI = "postgresql://{{ timesketch_db_user }}:{{ timesketch_db_password }}@timesketch-postgres:5432/{{ timesketch_db_name }}"

# Task Broker & Results Cache (Redis)
CELERY_BROKER_URL = "redis://timesketch-redis:6379/0"
CELERY_RESULT_BACKEND = "redis://timesketch-redis:6379/0"

# Search Engine (OpenSearch)
OPENSEARCH_HOST = "timesketch-opensearch"
OPENSEARCH_PORT = 9200

# Upload and Storage Pathing inside Container Environment
UPLOAD_ENABLED = True
UPLOAD_FOLDER = "/usr/share/timesketch/upload"
{%- endmacro %}

{{- timesketch_conf() -}}
