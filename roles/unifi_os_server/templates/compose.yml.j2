{% macro docker_compose() -%}
# SPDX-FileCopyrightText: Copyright © 2026, Jared W. Cook
# SPDX-License-Identifier: AGPL-3.0-or-later
---
networks:
  unifi_network:
    name: "{{ unifi_os_server_network_name | default('unifi-network') }}"

services:
  unifi_server:
    container_name: "{{ unifi_os_server_container_name | default('unifi-os-server') }}"
    image: "{{ unifi_os_server_image | default('jacobalberty/unifi') }}:{{ unifi_os_server_version | default('latest') }}"
    restart: "{{ unifi_os_server_restart_policy | default('unless-stopped') }}"
    networks:
      - unifi_network
    environment:
      - JVM_INIT_XMS={{ unifi_os_server_jvm_init_xms | default('1024m') }}
      - JVM_MAX_XMX={{ unifi_os_server_jvm_max_xmx | default('2048m') }}
      - TZ={{ unifi_os_server_timezone | default('UTC') }}
    volumes:
      - "{{ unifi_os_server_directory.data | default('/opt/unifi_os_server/data') }}:/unifi/data"
      - "{{ unifi_os_server_directory.log | default('/opt/unifi_os_server/logs') }}:/unifi/log"
      - "{{ unifi_os_server_directory.cert | default('/opt/unifi_os_server/cert') }}:/unifi/cert"
    ports:
      - "{{ unifi_os_server_port_http | default(8080) }}:8080/tcp"
      - "{{ unifi_os_server_port_https | default(8443) }}:8443/tcp"
      - "{{ unifi_os_server_port_portal | default(8843) }}:8843/tcp"
      - "{{ unifi_os_server_port_speedtest | default(6789) }}:6789/tcp"
      - "{{ unifi_os_server_port_stun | default(3478) }}:3478/udp"
      - "{{ unifi_os_server_port_discovery | default(10001) }}:10001/udp"
      - "{{ unifi_os_server_port_syslog | default(5514) }}:5514/udp"
{%- endmacro %}

{{- docker_compose() -}}
