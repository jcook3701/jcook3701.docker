{% macro docker_compose() -%}
# SPDX-FileCopyrightText: Copyright © 2026, Jared Cook
# SPDX-License-Identifier: AGPL-3.0-or-later
---
networks:
  unifi_network:
    name: "{{ unifi_os_server_network_name }}"

services:
  unifi_server:
    container_name: "{{ unifi_os_server_container_name }}"
    image: "{{ unifi_os_server_image }}:{{ unifi_os_server_version }}"
    restart: "{{ unifi_os_server_restart_policy }}"
    networks:
      - unifi_network
    environment:
      - JVM_INIT_XMS={{ unifi_os_server_jvm_init_xms }}
      - JVM_MAX_XMX={{ unifi_os_server_jvm_max_xmx }}
      - TZ={{ unifi_os_server_timezone | default('UTC') }}
    volumes:
      - "{{ unifi_os_server_data_dir }}:/unifi/data"
      - "{{ unifi_os_server_log_dir }}:/unifi/log"
      - "{{ unifi_os_server_cert_dir }}:/unifi/cert"
    ports:
      - "{{ unifi_os_server_port_http }}:8080/tcp"
      - "{{ unifi_os_server_port_https }}:8443/tcp"
      - "{{ unifi_os_server_port_portal }}:8843/tcp"
      - "{{ unifi_os_server_port_speedtest }}:6789/tcp"
      - "{{ unifi_os_server_port_stun }}:3478/udp"
      - "{{ unifi_os_server_port_discovery }}:10001/udp"
      - "{{ unifi_os_server_port_syslog }}:5514/udp"
{%- endmacro %}

{{- docker_compose() -}}
